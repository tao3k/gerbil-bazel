module(
    name = "gerbil_bazel",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

gerbil = use_extension(
    "//gerbil:extensions.bzl",
    "gerbil",
    dev_dependency = True,
)
gerbil.host(
    name = "local_gerbil",
    expected_version_prefixes = [
        "Gerbil f0badc7",
        "Gerbil d801e7a",
    ],
)
gerbil.host(
    name = "project_gerbil",
    expected_version_prefixes = [
        "Gerbil f0badc7",
        "Gerbil d801e7a",
    ],
    project_dependency_source_packages = ["clan"],
    project_library_relative_path = "project-library",
    project_root_marker = "//tests/smoke:project-root.marker",
)
gerbil.source_package(
    canonical_uri = "https://github.com/mighty-gerbils/gerbil-utils",
    name = "downloaded_fixture_sources",
    package = "gerbil-utils",
    revision = "f45a4ef3bfecd2af39e114ed736ce9082cbb8244",
    sha256 = "e7777c505e71de490dc05f8e3ff4473dddbc998a99899c085d31750add551296",
    strip_prefix = "gerbil-utils-f45a4ef3bfecd2af39e114ed736ce9082cbb8244",
    urls = [
        "https://github.com/mighty-gerbils/gerbil-utils/archive/f45a4ef3bfecd2af39e114ed736ce9082cbb8244.tar.gz",
    ],
)
use_repo(
    gerbil,
    "clan_sources",
    "downloaded_fixture_sources",
    "local_gerbil",
    "project_gerbil",
)

register_toolchains(
    "@local_gerbil//:registered_toolchain",
    dev_dependency = True,
)

source_resolution_replay = use_extension(
    "//tests/smoke:source_resolution_replay_extension.bzl",
    "source_resolution_replay",
    dev_dependency = True,
)
use_repo(
    source_resolution_replay,
    "source_resolution_git_worktree",
    "source_resolution_replay_a",
    "source_resolution_replay_b",
)

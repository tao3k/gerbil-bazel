+;; Observe default package identity without expanding a module body. Native
+;; headers and opaque readers retain their original cached import semantics.
+(def (core-read-module-id rpath)
+  (let* ((path (core-resolve-module-path rpath))
+         (head (call-with-input-source-file path
+                 (lambda (port)
+                   (if (eqv? (peek-char port) #\#)
+                     #f

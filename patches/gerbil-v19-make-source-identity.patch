+;; Reuse the actual import graph to put shared dependencies into the existing
+;; coordinator stream first. This changes no wait, target or worker capacity.
+(def (dependency-build-order specs module-id import-source source-path)
+  (def consumers (make-hash-table-eq))
+  (def positions (make-hash-table-eq))
+  (for-each (lambda (spec position)
+              (let (id (module-id spec))
+                (hash-put! consumers id 0)
+                (hash-put! positions id position)))
+            specs (iota (length specs)))
+  (for-each
+    (lambda (spec)
+      (def self (module-id spec))
+      (def seen (make-hash-table-eq))
+      (for-each
+        (lambda (entry)
+          (alet (id (expander-context-id (build-import-context entry)))
+            (def dependency (module-strip-nesting id))
+            (when (and (not (eq? dependency self))
+                       (hash-key? consumers dependency)
+                       (not (hash-key? seen dependency)))
+              (hash-put! seen dependency #t)
+              (hash-update! consumers dependency 1+ 0))))
+        (module-context-import (import-source (source-path spec)))))
+    specs)
+  (list-sort
+    (lambda (left right)
+      (let* ((left-id (module-id left)) (right-id (module-id right))
+             (a (hash-ref consumers left-id)) (b (hash-ref consumers right-id)))
+        (if (= a b)
+          (< (hash-ref positions left-id) (hash-ref positions right-id))
+          (> a b))))
+    specs))
+
+(def (build-import-context entry)
+  (cond
+    ((or (module-context? entry) (prelude-context? entry)) entry)
+    ((module-import? entry) (build-import-context (module-import-source entry)))
+    ((module-export? entry) (build-import-context (module-export-context entry)))
+    ((import-set? entry) (build-import-context (import-set-source entry)))
+    (else (error "unexpected import" entry))))
 

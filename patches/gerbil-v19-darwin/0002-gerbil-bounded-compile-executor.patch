diff --git a/src/gerbil/test/compiler-executor-test.ss b/src/gerbil/test/compiler-executor-test.ss
new file mode 100644
index 0000000..abfa8ac
--- /dev/null
+++ b/src/gerbil/test/compiler-executor-test.ss
@@ -0,0 +1,61 @@
+;;; -*- Gerbil -*-
+;;; bounded compiler executor contracts
+
+(import :std/test
+        :gerbil/compiler/base)
+(export compiler-executor-test)
+
+(def configured-workers
+  (max 1 (string->number (getenv "GERBIL_BUILD_CORES" "1"))))
+
+(def compiler-executor-test
+  (test-suite "compiler native-job executor"
+    (test-case "bounded execution and follow-up draining"
+      (def mx (make-mutex 'compiler-executor-test))
+      (def active 0)
+      (def peak 0)
+      (def seen (make-vector 8 0))
+      (def follow-up 0)
+
+      (def (locked thunk)
+        (mutex-lock! mx)
+        (unwind-protect (thunk) (mutex-unlock! mx)))
+
+      (def (work index)
+        (locked
+         (lambda ()
+           (set! active (fx1+ active))
+           (set! peak (max peak active))
+           (vector-set! seen index (fx1+ (vector-ref seen index)))))
+        (thread-sleep! 0.02)
+        (locked (lambda () (set! active (fx1- active)))))
+
+      (let loop ((index 0))
+        (when (fx< index 8)
+          (add-compile-job! (cut work index) `(contract ,index))
+          (loop (fx1+ index))))
+      (add-compile-job!
+       (lambda ()
+         (add-compile-job!
+          (lambda ()
+            (locked (lambda () (set! follow-up (fx1+ follow-up)))))
+          'follow-up))
+       'enqueue-follow-up)
+      (execute-pending-compile-jobs!)
+
+      (check (fx<= peak (min configured-workers 9)) => #t)
+      (when (fx> configured-workers 1)
+        (check (fx> peak 1) => #t))
+      (check (vector->list seen) => '(1 1 1 1 1 1 1 1))
+      (check (locked (lambda () follow-up)) => 1))
+
+    (test-case "first error propagates after queued work drains"
+      (def mx (make-mutex 'compiler-executor-error-test))
+      (def survived-error 0)
+      (add-compile-job! (lambda () (error "expected worker failure")) 'failure)
+      (add-compile-job!
+       (lambda ()
+         (with-lock mx (lambda () (set! survived-error 1))))
+       'after-failure)
+      (check-exception (execute-pending-compile-jobs!) true)
+      (check (with-lock mx (lambda () survived-error)) => 1))))

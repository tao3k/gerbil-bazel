(declare (standard-bindings) (extended-bindings) (not safe))

(define callback-count 0)
(define (##gb-prefix-callback value)
  (set! callback-count (+ callback-count 1))
  value)
(define (##gb-prefix-finish value)
  (##gb-prefix-callback
   (if (pair? (car value)) (caar value) (car value))))
(define (##gb-prefix-pair-finish value)
  (##gb-prefix-callback
   (cons (if (pair? (car value)) (caar value) (car value)) (cdr value))))
(define (##gb-prefix-invoke value)
  (##gb-prefix-finish (cons value 19)))
(define (##gb-prefix-pair-invoke value)
  (##gb-prefix-pair-finish (cons value 19)))
(define (##gb-tree-check value)
  (if (not value) (error "scalar boundary contract failed")))

(define (##gb-tree-run)
  (set! callback-count 0)
  (let ((input (cons 31 23)))
    (let loop ((i 0))
      (if (< i 512)
          (begin
            (##gb-tree-check (= (##gb-prefix-invoke input) 31))
            (let ((value (##gb-prefix-pair-invoke input)))
              (##gb-tree-check (= (car value) 31))
              (##gb-tree-check (= (cdr value) 19)))
            (loop (+ i 1)))))
    (##gb-tree-check (= callback-count 1024))
    (let ((a (##gb-prefix-pair-invoke input))
          (b (##gb-prefix-pair-invoke input)))
      (##gb-tree-check (not (eq? a b)))
      (set-car! a 41)
      (##gc)
      (##gb-tree-check (= (car b) 31)))
    (let ((original ##gb-prefix-callback))
      (set! ##gb-prefix-callback (lambda (value) (##gc) value))
      (##gb-tree-check (= (##gb-prefix-invoke input) 31))
      (##gb-tree-check (= (car (##gb-prefix-pair-invoke input)) 31))
      (set! ##gb-prefix-callback (lambda (value) (values value 43)))
      (call-with-values
        (lambda () (##gb-prefix-invoke input))
        (lambda (first second)
          (##gb-tree-check (= first 31))
          (##gb-tree-check (= second 43))))
      (set! ##gb-prefix-callback (lambda (value) (error "expected callback escape")))
      (##gb-tree-check
        (with-exception-catcher (lambda (exception) #t)
          (lambda () (##gb-prefix-invoke input) #f)))
      (let ((value (call-with-current-continuation
                     (lambda (return)
                       (set! ##gb-prefix-callback (lambda (value) (return value)))
                       (##gb-prefix-pair-invoke input)))))
        (##gb-tree-check (= (car value) 31))
        (##gb-tree-check (= (cdr value) 19)))
      (set! ##gb-prefix-callback original))
    (let ((original ##gb-prefix-finish))
      (set! ##gb-prefix-finish (lambda (value) (##gc) value))
      (let ((value (##gb-prefix-invoke input)))
        (##gb-tree-check (eq? (car value) input))
        (##gb-tree-check (= (cdr value) 19)))
      (set! ##gb-prefix-finish original)))
  #t)

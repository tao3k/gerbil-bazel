(let ((adjacency (vector '(1) '(0 2) '()))
      (selected (vector #t #f #f)))
  (gerbil-ascent-graph-close! adjacency selected)
  (unless (and (equal? selected '#(#t #t #t))
               (equal? adjacency '#((1) (0 2) ())))
    (error "graph closure changed input or selected set"))
  (let (components (gerbil-ascent-graph-components adjacency))
    (unless (equal? components '((0 1) (2)))
      (error "graph component result changed" components))))
(let* ((frame (vector 11 17))
       (calls [])
       (callback (lambda (left right)
                   (set! calls (cons (list left right) calls))
                   (+ left right)))
       (invoke (gerbil-ascent-compile-frame-call callback '(1 0))))
  (unless (null? calls) (error "frame callback executed during preparation"))
  (unless (= (invoke frame) 28) (error "frame callback value changed"))
  (vector-set! frame 0 23)
  (unless (and (= (invoke frame) 40) (equal? calls '((17 23) (17 11))))
    (error "callback did not read current mutable frame" calls)))
(let ((count ((##eval 'bundle-image-count))))
  (display "REAL-BUNDLE-CORE-OK image-delta=")
  (display (- count (##eval 'bundle-image-before)))
  (newline))

(define (run-real-generated-c-closure!)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (source (string-append root "/source"))
         (output (string-append root "/published"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (tools (list (string-append bin "/gsc") hash-tool
                      (getenv "GENERATION_JOURNAL") (getenv "GENERATION_IMPLEMENTATION")
                      (getenv "GENERATION_CONTRACT")))
         (inputs (call-with-input-file (string-append root "/ordered-inputs.txt")
                   (lambda (port)
                     (let loop ((paths '()))
                       (let ((path (read-line port)))
                         (if (eof-object? path) (reverse paths)
                             (loop (cons path paths))))))))
         (proof (string-append output "/closure.proof")))
    (define (timed work name)
      (let* ((start (time->seconds (current-time)))
             (pinned (reuse-generated-c-closure! inputs '((target C)) output (string-append root "/" work)
                       proof hash-tool tools)))
        (display "REAL-GENERATED-C-CLOSURE ") (display name) (display " ")
        (write (- (time->seconds (current-time)) start)) (newline)
        pinned))
    (if (not (= (length inputs) 55)) (error "unexpected source inventory"))
    (let* ((first (timed "work-first" "populate"))
           (second (timed "work-second" "hit")))
      (if (not (equal? first second)) (error "repeat changed pinned identities"))
      (call-with-output-file (string-append root "/pinned-inputs.txt")
        (lambda (port) (for-each (lambda (path) (display path port) (newline port)) second))))
    (if (not (null? (directory-files (string-append root "/work-second"))))
        (error "hit performed generation"))
    (display "REAL-GENERATED-C-CLOSURE-OK 55\n")))

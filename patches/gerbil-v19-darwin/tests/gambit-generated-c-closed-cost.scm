;; Exercise the existing closed-set producer, not an ordinary multi-input CLI batch.
(define (run-closed-generation-cost!)
  (let* ((directory (getenv "CLOSED_COST_DIRECTORY"))
         (receipt (getenv "CLOSED_COST_RECEIPT"))
         (hash-tool (getenv "CLOSED_COST_HASH_TOOL"))
         (probe (getenv "CLOSED_COST_PROBE"))
         (inputs (call-with-input-file (getenv "CLOSED_COST_INPUTS")
                   (lambda (port)
                     (let loop ((paths '()))
                       (let ((line (read-line port)))
                         (if (eof-object? line) (reverse paths)
                             (loop (cons (path-expand line directory) paths))))))))
         (outputs (map (lambda (path) (string-append (path-strip-extension path) ".c")) inputs))
         (tools (list (path-normalize (executable-path)) hash-tool probe))
         (options '((target C)))
         (proof (path-expand "closed.proof" receipt))
         (reference #f))
    (define (check-output!)
      (let ((digests (c#generation-file-digests hash-tool outputs)))
        (if reference
            (if (not (equal? reference digests)) (error "closed producer C parity failure"))
            (set! reference digests))))
    (define (measure name procedure)
      (let ((start (time->seconds (current-time))))
        (procedure)
        (let ((elapsed (- (time->seconds (current-time)) start)))
          (display "CLOSED-GENERATION-COST ") (write (list name elapsed)) (newline)))
      (check-output!))
    (define (ordinary)
      (for-each (lambda (input output)
                  (compile-file-to-target input options: options output: output)) inputs outputs))
    (define (closed name)
      (let ((work (path-expand name receipt)))
        (create-directory work)
        (let ((pins (c#reuse-generated-c-closure! inputs options directory work proof hash-tool tools)))
          (if (string=? name "hit-work")
              (call-with-output-file (path-expand "pinned-inputs.txt" receipt)
                (lambda (port)
                  (for-each (lambda (path) (display path port) (newline port)) pins)))))))
    (measure 'ordinary-before ordinary)
    (measure 'closed-populate (lambda () (closed "populate-work")))
    (if (not (file-exists? proof)) (error "closed producer did not admit a proof"))
    (measure 'closed-hit (lambda () (closed "hit-work")))
    (measure 'ordinary-after ordinary)
    (display "CLOSED-GENERATION-C-PARITY-OK modules=") (write (length inputs)) (newline)))

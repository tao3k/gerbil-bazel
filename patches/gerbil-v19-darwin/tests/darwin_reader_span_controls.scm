(load (getenv "READER_TOKEN_CONTROLS"))
(check "actual span entry enabled" (procedure? ##gb-darwin-buffered-span))
(define (span text close remaining)
  (let ((port (open-input-string text)))
    (peek-char port)
    (let ((result (##gb-darwin-buffered-span (get-readenv port) close remaining)))
      (cons result (peek-char port)))))
(check "span stops before close" (equal? (span "abc\"" #\" 512) '("abc" . #\")))
(check "span stops before escape" (equal? (span "abc\\n" #\" 512) '("abc" . #\\)))
(check "span stops before newline" (equal? (span "abc\n" #\" 512) '("abc" . #\newline)))
(check "span respects remaining chunk size" (equal? (span "abcdef" #\" 3) '("abc" . #\d)))
(check "span can exhaust current buffer" (equal? (span "abc" #\" 512) (cons "abc" (eof-object))))
(check "empty close falls back without consumption" (equal? (span "\"" #\" 512) '(#f . #\")))
(check "escape falls back without consumption" (equal? (span "\\n" #\" 512) '(#f . #\\)))
(check "zero remaining falls back" (equal? (span "abc" #\" 0) '(#f . #\a)))
(check "oversized remaining falls back" (equal? (span "abc" #\" 513) '(#f . #\a)))
(check "span leaves Unicode untouched"
  (equal? (span (string-append "abc" (string unicode)) #\" 512) (cons "abc" unicode)))
(define (literal value)
  (call-with-output-string (lambda (port) (write value port))))
(for-each
 (lambda (row)
   (check (string-append "literal round trip " (car row))
     (equal? (call-with-input-string (literal (cdr row)) read) (cdr row))))
 (list (cons "empty" "") (cons "plain" "abc def")
       (cons "quote" "abc\"def") (cons "backslash" "abc\\def")
       (cons "newline" "abc\ndef") (cons "Unicode" (string-append "abc" (string unicode) "def"))
       (cons "511" (make-string 511 #\a)) (cons "512" (make-string 512 #\a))
       (cons "513" (make-string 513 #\a)) (cons "16384" (make-string 16384 #\a))
       (cons "escape at chunk boundary" (string-append (make-string 511 #\a) "\nend"))))
(check "pipe escaped identifier unchanged"
  (equal? (call-with-input-string "|abc\\|def|" read) (string->symbol "abc|def")))
(check "hex escape unchanged" (equal? (call-with-input-string "\"abc\\u0041def\"" read) "abcAdef"))
(check "octal escape unchanged" (equal? (call-with-input-string "\"abc\\101def\"" read) "abcAdef"))
(check "incomplete string still raises"
  (with-exception-catcher
    (lambda (e) (read-error? (if (RuntimeException? e) (RuntimeException-exception e) e)))
    (lambda () (call-with-input-string "\"abc" read) #f)))
(let ((port (open-input-string "\"abc\ndef\" tail")))
  (check "literal actual newline unchanged" (equal? (read port) "abc\ndef"))
  (check "literal newline position retained"
    (and (= (input-port-line port) 2) (= (input-port-column port) 5))))
(let ((port (open-input-string "abcdef\"")))
  (peek-char port)
  (##gb-darwin-buffered-span (get-readenv port) #\" 3)
  (##gc)
  (check "span survives GC between runs"
    (equal? (##gb-darwin-buffered-span (get-readenv port) #\" 512) "def")))
(display "OK") (newline) (force-output)

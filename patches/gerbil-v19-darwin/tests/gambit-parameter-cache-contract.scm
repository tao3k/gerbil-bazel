(declare (standard-bindings) (extended-bindings) (not safe))
(c-declare "#include \"gambit-parameter-cache-probe.h\"")
(define cache-status
  (c-lambda (scheme-object) int
    "___WORD answer; ___result = gambit_parameter_cached(___PSTATE, ___arg1, &answer);"))
(define original-status
  (c-lambda () int
    "___WORD ___temp; ___result = ___CLOSUREP(___PRMCELL(___G__23__23_current_2d_exception_2d_handler.prm));"))
(define checks 0)
(define (check value expected)
  (if (not (equal? value expected)) (error "parameter contract" value expected))
  (set! checks (+ checks 1)))
(define p (make-parameter 1))
(define q (make-parameter 2))
(define filters 0)
(define filtered (make-parameter 3 (lambda (x) x)
                  (lambda (x) (set! filters (+ filters 1)) (+ x 10))))
(display "PARAMETER-ORIGINAL-STATUS ") (display (original-status)) (newline)
(let loop ((n 0))
  (if (< n 100)
      (begin
        (check (p) 1)
        (parameterize ((p (+ n 20)) (q (+ n 30)))
          (check (p) (+ n 20))
          (check (p) (+ n 20))
          (check (q) (+ n 30))
          (check (call-with-values (lambda () (p)) list) (list (+ n 20)))
          (##gc)
          (check (p) (+ n 20)))
        (check (p) 1)
        (check (filtered) 13)
        (check (cache-status filtered) 1)
        (check (cache-status (lambda () 77)) 0)
        (loop (+ n 1)))))
(check filters 100)
(check (call/cc (lambda (escape) (parameterize ((p 99)) (escape (p))))) 99)
(check (p) 1)
(p 5) (check (p) 5)
(check (with-exception-catcher (lambda (e) 'caught) (lambda () (p 1 2))) 'caught)
(display "PARAMETER-CACHE-OK ") (display checks) (newline)

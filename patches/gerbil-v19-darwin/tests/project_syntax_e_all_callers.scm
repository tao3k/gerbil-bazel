(define (projection-datum-uses node name)
  (cond
    ((and (pair? node) (eq? (car node) 'quote)) 0)
    ((pair? node)
     (+ (projection-datum-uses (car node) name)
        (projection-datum-uses (cdr node) name)))
    (else (if (eq? node name) 1 0))))

(define (projection-transform-all forms)
  (let ((changes '()))
    (define (transform node owner)
      (cond
        ((not (pair? node)) node)
        ((eq? (car node) 'quote) node)
        (else
          (let ((owner (if (and (eq? (car node) 'define) (pair? (cdr node)))
                         (cadr node) owner)))
            (define (project field argument shape)
              (set! changes (cons (list owner field shape) changes))
              (list (if (eq? field 'car) 'projection/car 'projection/cdr)
                    (transform argument owner)))
            (define (unchanged)
              (cons (transform (car node) owner) (transform (cdr node) owner)))
            (cond
              ((and (list? node) (= (length node) 2)
                    (memq (car node) '(##car ##cdr car cdr))
                    (list? (cadr node)) (= (length (cadr node)) 2)
                    (eq? (caadr node) 'gx#syntax-e))
               (project (if (memq (car node) '(car ##car)) 'car 'cdr)
                        (cadadr node) 'direct))
              ((and (list? node) (= (length node) 3) (eq? (car node) 'let)
                    (list? (cadr node)) (= (length (cadr node)) 1)
                    (list? (caadr node)) (= (length (caadr node)) 2))
               (let* ((binding (caadr node)) (pair-name (car binding))
                      (call (cadr binding)) (inner (caddr node)))
                 (if (and (list? call) (= (length call) 2)
                          (eq? (car call) 'gx#syntax-e))
                   (cond
                     ((and (list? inner) (= (length inner) 2)
                           (memq (car inner) '(##car ##cdr car cdr))
                           (eq? (cadr inner) pair-name))
                      (project (if (memq (car inner) '(car ##car)) 'car 'cdr)
                               (cadr call) 'single-return))
                     ((and (list? inner) (>= (length inner) 3)
                           (eq? (car inner) 'let) (list? (cadr inner))
                           (= (length (cadr inner)) 2))
                      (let ((head (caadr inner)) (tail (cadadr inner)))
                        (if (and (list? head) (= (length head) 2)
                                 (list? tail) (= (length tail) 2)
                                 (equal? (cadr head) (list '##car pair-name))
                                 (equal? (cadr tail) (list '##cdr pair-name))
                                 (= (projection-datum-uses (cddr inner) pair-name) 0))
                          (let ((head-used (> (projection-datum-uses (cddr inner) (car head)) 0))
                                (tail-used (> (projection-datum-uses (cddr inner) (car tail)) 0)))
                            (if (eq? head-used tail-used) (unchanged)
                              (let ((selected (if head-used head tail))
                                    (field (if head-used 'car 'cdr)))
                                (cons 'let
                                  (cons (list (list (car selected)
                                                    (project field (cadr call) 'unused-binding)))
                                    (map (lambda (body) (transform body owner)) (cddr inner)))))))
                          (unchanged))))
                     (else (unchanged)))
                   (unchanged))))
              (else (unchanged)))))))
    (let ((result (map (lambda (form) (transform form #f)) forms)))
      (cons result (reverse changes)))))

(define (projection-transform-file input output)
  (let* ((forms (call-with-input-file input
                  (lambda (port)
                    (let loop ((forms '()))
                      (let ((form (read port)))
                        (if (eof-object? form) (reverse forms)
                          (loop (cons form forms))))))))
         (result (projection-transform-all forms)))
    (if (pair? (cdr result))
      (begin
        (if (file-exists? output) (error "refusing existing output" output))
        (call-with-output-file output
          (lambda (port)
            (for-each (lambda (form) (write form port) (newline port)) (car result))))))
    (cdr result)))

(define (run-produced-generated-c-contract!)
  (let* ((root (getenv "GENERATION_FIXTURE")) (bin (getenv "GENERATION_BIN"))
         (input (string-append root "/module.scm"))
         (static (string-append root "/producer-alias.scm"))
         (output (string-append root "/published"))
         (proof (string-append output "/module.c.generation-proof"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (identity (string-append root "/tool.identity"))
         (options '((module-ref producer-alias) (linker-name "producer-alias")))
         (tools (list (string-append bin "/gsc") hash-tool
                      (getenv "GENERATION_JOURNAL") (getenv "GENERATION_IMPLEMENTATION")
                      (getenv "GENERATION_CONTRACT") identity)))
    (define (put path text)
      (call-with-output-file (list path: path truncate: #t)
        (lambda (port) (display text port))))
    (define (lookup)
      (lookup-produced-generated-c static input options output proof
        (string-append root "/lookup") hash-tool tools))
    (put input "(define (answer) 17)\n")
    (put identity "tool-v1\n")
    (copy-file input static)
    (let ((pin (car (reuse-generated-c-closure! (list input) options output
                      (string-append root "/produce") proof hash-tool tools))))
      (if (not (equal? pin (lookup))) (error "valid producer not adopted"))
      (let ((original lookup-produced-generated-c/internal)
            (request (list static input options output proof)))
        (dynamic-wind
          (lambda ()
            (set! lookup-produced-generated-c/internal
              (lambda args
                (let ((result (apply original args)))
                  (put identity "tool-v2\n") result))))
          (lambda ()
            (if (lookup-produced-generated-c-batch (list request) (string-append root "/lookup") hash-tool tools)
                (error "batch admitted tools changed during lookup")))
          (lambda ()
            (set! lookup-produced-generated-c/internal original)
            (put identity "tool-v1\n"))))
      (for-each
        (lambda (changed)
          (let ((original lookup-produced-generated-c/internal)
                (request (list static input options output proof)))
            (dynamic-wind
              (lambda ()
                (set! lookup-produced-generated-c/internal
                  (lambda args
                    (let ((result (apply original args)))
                      (put changed "(define (answer) 29)\n") result))))
              (lambda ()
                (if (lookup-produced-generated-c-batch (list request) (string-append root "/lookup") hash-tool tools)
                    (error "batch admitted source changed after leaf validation" changed)))
              (lambda ()
                (set! lookup-produced-generated-c/internal original)
                (put changed "(define (answer) 17)\n")))))
        (list static input))
      (for-each
        (lambda (changed)
          (let ((original lookup-produced-generated-c/internal)
                (saved (string-append root "/saved-batch-file"))
                (request (list static input options output proof)))
            (copy-file changed saved)
            (dynamic-wind
              (lambda ()
                (set! lookup-produced-generated-c/internal
                  (lambda args
                    (let ((result (apply original args)))
                      (put changed "corrupt-after-validation\n") result))))
              (lambda ()
                (if (lookup-produced-generated-c-batch (list request) (string-append root "/lookup") hash-tool tools)
                    (error "batch admitted changed proof or pin" changed)))
              (lambda ()
                (set! lookup-produced-generated-c/internal original)
                (delete-file changed)
                (rename-file saved changed)))))
        (list proof pin))
      (let ((original lookup-produced-generated-c/internal)
            (request (list static input options output proof))
            (previous (getenv "GAMBIT_BATCH_ENVIRONMENT_FIXTURE" #f)))
        (dynamic-wind
          (lambda ()
            (set! lookup-produced-generated-c/internal
              (lambda args
                (let ((result (apply original args)))
                  (setenv "GAMBIT_BATCH_ENVIRONMENT_FIXTURE" "changed-after-validation") result))))
          (lambda ()
            (if (lookup-produced-generated-c-batch (list request) (string-append root "/lookup") hash-tool tools)
                (error "batch admitted changed environment")))
          (lambda ()
            (set! lookup-produced-generated-c/internal original)
            (if previous (setenv "GAMBIT_BATCH_ENVIRONMENT_FIXTURE" previous)
                (setenv "GAMBIT_BATCH_ENVIRONMENT_FIXTURE")))))
      (if (not (equal? (list pin)
                       (lookup-produced-generated-c-batch
                         (list (list static input options output proof))
                         (string-append root "/lookup") hash-tool tools)))
          (error "unchanged batch rejected"))
      (call-with-output-file (string-append root "/pinned-input.txt")
        (lambda (port) (display pin port) (newline port)))
      (put static "(define (answer) 29)\n")
      (if (lookup) (error "different static source adopted"))
      (put static "(define (answer) 17)\n")
      (let ((before (generation-file-sha hash-tool pin)))
        (put input "(define (answer) 29)\n")
        (if (lookup) (error "changed producer source adopted"))
        (if (not (equal? before (generation-file-sha hash-tool pin)))
            (error "lookup changed earlier producer")))
      (put input "(define (answer) 17)\n")
      (if (not (equal? pin (lookup))) (error "restored source proof not admitted"))
      (let ((saved (string-append root "/saved-proof")))
        (rename-file proof saved)
        (if (lookup) (error "missing proof generated a substitute"))
        (if (file-exists? proof) (error "lookup published a proof"))
        (rename-file saved proof))
      (if (not (null? (directory-files (string-append root "/lookup"))))
          (error "lookup left scratch outputs"))
      (let ((first-proof-sha (generation-file-sha hash-tool proof)))
        (put (string-append root "/value.scm") "(define included-value 17)\n")
        (put input "(include \"value.scm\")\n(define (answer) included-value)\n")
        (delete-file static)
        (copy-file input static)
        (create-directory (string-append root "/produce-include"))
        (reuse-generated-c-closure! (list input) options output
          (string-append root "/produce-include") proof hash-tool tools)
        (let ((before (generation-file-sha hash-tool proof)))
          (if (equal? before first-proof-sha) (error "include fixture did not replace proof"))
          (if (lookup) (error "transitive read context incorrectly projected"))
          (if (not (equal? before (generation-file-sha hash-tool proof)))
              (error "include denial changed proof"))))
      ;; Preserve the initial admitted source for the independent original-link control.
      (put static "(define (answer) 17)\n")
      (display "PRODUCED-GENERATED-C-CONTRACT-OK adoption static-change producer-change missing-proof include-rejected batch-tool-change-rejected batch-static-change-rejected batch-producer-change-rejected batch-proof-change-rejected batch-pin-change-rejected batch-environment-change-rejected unchanged-batch no-generation\n"))))

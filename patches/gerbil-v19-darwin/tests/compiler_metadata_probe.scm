(eval '(import :gerbil/compiler))

(define metadata-calls '())
(define metadata-depth 0)
(define metadata-descendant-cpu 0.)
(define metadata-original-import (gx#current-expander-module-import))
(define (metadata-path? path)
  (let ((text (cond ((string? path) path)
                    ((symbol? path) (symbol->string path))
                    (else ""))))
    (let ((n (string-length text)) (suffix ".ssxi.ss"))
      (and (>= n (string-length suffix))
           (string=? (substring text (- n (string-length suffix)) n) suffix)))))
(define (metadata-cpu)
  (let ((s (##process-statistics)))
    (+ (f64vector-ref s 0) (f64vector-ref s 1))))
(define (metadata-import path . args)
  (if (not (metadata-path? path))
    (apply metadata-original-import path args)
    (let ((depth metadata-depth)
          (children-before metadata-descendant-cpu)
          (cpu-before (metadata-cpu)))
      (set! metadata-depth (+ metadata-depth 1))
      (let* ((result (apply metadata-original-import path args))
             (inclusive (- (metadata-cpu) cpu-before))
             (children (- metadata-descendant-cpu children-before))
             (own (- inclusive children)))
        (set! metadata-depth depth)
        (set! metadata-descendant-cpu (+ children-before inclusive))
        (set! metadata-calls
          (cons (list depth path inclusive own (thread-name (current-thread))) metadata-calls))
        result))))

(define (metadata-code-inventory source output)
  (let* ((base (path-strip-extension (path-strip-directory source)))
         (timestamp-name (string->symbol (string-append base "::timestamp"))))
    (for-each
      (lambda (suffix)
        (let ((path (path-expand (string-append base suffix) output))
              (timestamp-count 0))
          (define (normalize form)
            (cond
              ((and (pair? form) (eq? (car form) 'begin))
               (cons 'begin (map normalize (cdr form))))
              ((and (pair? form) (eq? (car form) 'define)
                    (pair? (cdr form)) (eq? (cadr form) timestamp-name))
               (unless (and (= (length form) 3) (integer? (caddr form)))
                 (error "exact generated timestamp definition required" form))
               (set! timestamp-count (+ timestamp-count 1))
               (list 'define timestamp-name 'diagnostic-timestamp))
              (else form)))
          (let ((forms (call-with-input-file path
                         (lambda (port)
                           (let loop ((forms '()))
                             (let ((form (read port)))
                               (if (eof-object? form) (reverse forms)
                                 (loop (cons (normalize form) forms)))))))))
            (unless (= timestamp-count 1)
              (error "one generated timestamp definition required" path timestamp-count))
            (display "METADATA-CODE\t") (write suffix) (display "\t")
            (write forms) (newline))))
      '("~0.scm"))))

(define (metadata-compile source output observe?)
  (let ((before (metadata-cpu)))
    (dynamic-wind
      (lambda ()
        (when observe? (gx#current-expander-module-import metadata-import)))
      (lambda ()
        (gxc#compile-module source
          (list output-dir: output optimize: #t debug: #f
                invoke-gsc: #f keep-scm: #t static: #t generate-ssxi: #t)))
      (lambda () (gx#current-expander-module-import metadata-original-import)))
    (display "METADATA-COMPILE-CPU\t") (write (- (metadata-cpu) before)) (newline))
  (metadata-code-inventory source output)
  (metadata-emit))

(define (metadata-emit)
  (for-each
    (lambda (row)
      (display "METADATA-CALL")
      (for-each (lambda (value) (display "\t") (write value)) row)
      (newline))
    (reverse metadata-calls))
  (unless (eq? metadata-original-import (gx#current-expander-module-import))
    (error "original import parameter was not restored"))
  (unless (= metadata-depth 0)
    (error "incomplete metadata observation" metadata-depth))
  (displayln "OK metadata-compile")
  (force-output))

(define (metadata-workers source output workers)
  (eval '(import :std/make))
  (let ((specs (map (lambda (i) (string-append "m" (number->string i))) (iota workers)))
        (before (metadata-cpu)))
    (dynamic-wind
      (lambda () (gx#current-expander-module-import metadata-import))
      (lambda ()
        (eval `(make ',specs srcdir: ,source libdir: ,output prefix: "probe"
                     optimize: #t parallelize: ,workers verbose: #t)))
      (lambda () (gx#current-expander-module-import metadata-original-import)))
    (display "METADATA-COMPILE-CPU\t") (write (- (metadata-cpu) before)) (newline)
    (set-load-path! (cons output (load-path)))
    (for-each
      (lambda (i)
        (let ((id (string->symbol (string-append ":probe/m" (number->string i))))
              (function (string->symbol (string-append "value_m" (number->string i)))))
          (eval `(import ,id))
          (unless (= (eval `(,function ,i)) i)
            (error "compiled consumer returned wrong value" id))
          (display "METADATA-CONSUMER-OK\t") (write i) (newline)))
      (iota workers)))
  (metadata-emit))

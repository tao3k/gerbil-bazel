;; Experimental link consumer; no singleton producer hook is installed.
(define (generated-c-closed-link-options? options)
  (let loop ((rest options) (seen '()))
    (if (null? rest)
        (memq 'link seen)
        (let ((option (car rest)))
          (and (list? option) (pair? option) (not (memq (car option) seen))
               (case (car option)
                 ((link flat) (and (= (length option) 1)
                                   (loop (cdr rest) (cons (car option) seen))))
                 ((target) (and (equal? option '(target C))
                                (loop (cdr rest) (cons 'target seen))))
                 ((o l) (and (= (length option) 2) (string? (cadr option))
                             (loop (cdr rest) (cons (car option) seen))))
                 (else #f)))))))

(define (generated-c-closed-link-inputs arguments)
  (let loop ((rest arguments) (files '()) (targets '()))
    (if (null? rest)
        (reverse files)
        (let ((input (car rest)))
          (cond
            ((member input '("-preload" "-nopreload"))
             (loop (cdr rest) files targets))
            ((and (string? input) (> (string-length input) 0)
                  (not (char=? (string-ref input 0) #\-))
                  (member (path-extension input) '(".scm" ".c"))
                  (generation-regular? input))
             (let* ((path (path-normalize input))
                    (target (if (string=? (path-extension path) ".scm")
                                (string-append (path-strip-extension path) ".c") path)))
               ;; A Scheme producer must not rewrite another selected C input.
               (and (not (member path files)) (not (member target targets))
                    (loop (cdr rest) (cons path files) (cons target targets)))))
            (else #f))))))

(define (generated-c-closed-link-remove-owned path)
  (if (eq? (file-info-type (file-info path #f)) 'directory)
      (begin
        (for-each (lambda (name)
                    (generated-c-closed-link-remove-owned (path-expand name path)))
                  (directory-files path))
        (delete-directory path))
      (delete-file path)))

(define (generated-c-closed-link-arguments options arguments target binding entry-input)
  (let* ((os (symbol->string (caddr (system-type))))
         (files (and binding (generated-c-closed-link-inputs arguments))))
    (if (not (and binding (string? binding) (not (file-exists? binding))
                  (>= (string-length os) 6) (string=? (substring os 0 6) "darwin")
                  (eq? target 'C)
                  (equal? (getenv "GAMBIT_DARWIN_CLOSED_LINK_REUSE" #f) "1")
                  (generated-c-closed-link-options? options) (pair? files)))
        arguments
        (let* ((executable (path-normalize (executable-path)))
               (hash-tool (string-append (path-directory executable) "gambit-file-sha256"))
               (tools (list executable hash-tool))
               (work (create-temporary-directory (string-append binding ".work-")))
               (mapping '())
               (records '())
               (failed? #f)
               (failure #f))
          (let ((result (dynamic-wind
            (lambda () #f)
            (lambda ()
             (with-exception-catcher
              (lambda (error) (set! failed? #t) (set! failure error) #f)
              (lambda ()
              (if (and entry-input
                       (not (and (string? entry-input)
                                 (member (path-normalize entry-input) files))))
                  (error "closed link entry role is not a selected input"))
              ;; Keep generation order, even across directories/entry roles.
              ;; Complete ordered membership still belongs to every proof.
              (let ((groups '()))
                (for-each
                  (lambda (file)
                    (if (string=? (path-extension file) ".scm")
                        (let* ((directory (path-directory file))
                               (entry? (and entry-input (equal? file (path-normalize entry-input))))
                               (key (list directory entry?))
                               (group (and (pair? groups) (car groups))))
                          (if (and group (equal? key (car group)))
                              (set-cdr! group (append (cdr group) (list file)))
                              (set! groups (cons (cons key (list file)) groups))))))
                  files)
                (for-each
                  (lambda (group)
                    (let* ((directory (caar group)) (inputs (cdr group))
                           (membership (generation-context-sha hash-tool
                                         (list 'closed-link-members-v2 (cadar group) inputs)
                                         (string-append work "/membership")))
                           (proof (string-append directory ".gambit-closed-link-" membership ".proof"))
                           (group-work (create-temporary-directory (string-append work "/group-")))
                           (pins (reuse-generated-c-closure! inputs '((target C))
                                   directory group-work proof hash-tool tools)))
                      (if generated-c-observed-macro-context?
                          (error "closed link source context is not reusable"))
                      (for-each
                        (lambda (input pin)
                          (let ((logical (string-append (path-strip-extension input) ".c"))
                                (sha (generation-file-sha hash-tool pin)))
                            (set! mapping (cons (cons input pin) mapping))
                            (set! records (cons (list input logical sha) records))))
                        inputs pins)))
                  (reverse groups)))
              ;; Existing C must be pinned too: a concurrent logical producer
              ;; cannot change the metadata read by the linker.
              (for-each
                (lambda (file)
                  (if (string=? (path-extension file) ".c")
                      (let* ((sha (generation-file-sha hash-tool file))
                             (pin (car (generation-pin-outputs hash-tool
                                         (list (list file file sha)) work))))
                        (set! mapping (cons (cons file pin) mapping))
                        (set! records (cons (list file file sha) records)))))
                files)
              (for-each
                (lambda (entry)
                  (let ((pin (cdr (assoc (car entry) mapping))))
                    (if (not (equal? (caddr entry) (generation-file-sha hash-tool pin)))
                        (error "closed link pin changed")))) records)
              (let ((pending (string-append work "/binding")))
                (call-with-output-file (list path: pending permissions: #o600)
                  (lambda (port)
                    (write (list 'gambit-closed-link-binding-v1
                                 (map (lambda (file) (assoc file records)) files)) port)
                    (newline port)))
                (rename-file pending binding #f))
              (display "GAMBIT-CLOSED-LINK-SELECTED ") (write (length files)) (newline)
              (map (lambda (input)
                     (if (member input '("-preload" "-nopreload")) input
                         (cdr (assoc (path-normalize input) mapping)))) arguments))))
            (lambda () (generated-c-closed-link-remove-owned work)))))
            (if failed? (raise failure) result))))))

(def (check label expected actual)
  (unless (equal? expected actual)
    (error label expected actual))
  (display "CASE-OK ") (displayln label) (force-output))

(def (child settings)
  (let* ((process (open-input-process settings))
         (output (read-line process))
         (status (process-status process)))
    (close-input-port process)
    (cons status output)))

(def fixture (getenv "GB_SPAWN_FIXTURE"))
(def selected-env (list (string-append "PATH=" fixture)))
(check "absolute-path-unchanged" '(0 . "ABSOLUTE")
       (child (list path: "/bin/sh" environment: '("PATH=/not-present")
                    arguments: '("-c" "printf ABSOLUTE"))))
(check "child-path" '(0 . "CHILD")
       (child (list path: "selected" environment: selected-env)))
(check "empty-path-child-cwd" '(0 . "CHILD")
       (child (list path: "selected" environment: '("PATH=") directory: fixture)))
(check "relative-path-child-cwd" '(0 . "CHILD")
       (child (list path: "selected" environment: '("PATH=.:/not-present") directory: fixture)))
(check "trailing-empty-path" '(0 . "CHILD")
       (child (list path: "selected" environment: '("PATH=/not-present:") directory: fixture)))
(check "missing-path-default" '(0 . "DEFAULT")
       (child (list path: "sh" environment: '()
                    arguments: '("-c" "printf DEFAULT"))))
(check "no-shebang-shell-fallback" '(3328 . "SCRIPT")
       (child (list path: "no-shebang" environment: selected-env)))
(check "child-env-value" '(0 . "CHILD-VALUE")
       (child (list path: "sh" environment: '("PATH=/bin:/usr/bin" "VALUE=CHILD-VALUE")
                    arguments: '("-c" "printf %s \"$VALUE\""))))
(check "stderr-redirection" '(1792 . "STDERR")
       (child (list path: "sh" environment: '("PATH=/bin:/usr/bin")
                    arguments: '("-c" "printf STDERR >&2; exit 7") stderr-redirection: #t)))
(check "EACCES-search-continues" '(0 . "CHILD")
       (child (list path: "selected"
                    environment: (list (string-append "PATH=" fixture "/blocked:" fixture)))))
(check "ENOTDIR-search-continues" '(0 . "CHILD")
       (child (list path: "selected"
                    environment: (list (string-append "PATH=" fixture "/no-shebang:" fixture)))))
(check "missing-command" #t
       (with-catch no-such-file-or-directory-exception?
         (lambda () (child (list path: "definitely-missing" environment: selected-env)) #f)))
(check "empty-command" #t
       (with-catch no-such-file-or-directory-exception?
         (lambda () (child (list path: "" environment: selected-env)) #f)))
(displayln "OK child-path-spawn-semantics")

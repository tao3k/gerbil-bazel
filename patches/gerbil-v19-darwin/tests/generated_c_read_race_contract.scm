(define (run-generated-c-read-race-contract!)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (native? (equal? (getenv "GENERATION_NATIVE" #f) "1"))
         (reuse-generated-c-closure! (if native? c#reuse-generated-c-closure! reuse-generated-c-closure!))
         (generation-file-sha (if native? c#generation-file-sha generation-file-sha))
         (input (string-append root "/module.scm"))
         (output (string-append root "/published/module.c"))
         (control (string-append root "/control/module.c"))
         (proof (string-append output ".generation-proof"))
         (tool (getenv "GENERATION_HASH_TOOL"))
         (tools (list (executable-path) tool (getenv "GENERATION_CONTRACT")
                      (getenv "GENERATION_JOURNAL") (getenv "GENERATION_IMPLEMENTATION")))
         (reader ##read-all-as-a-begin-expr-from-path)
         (injected? #f)
         (a "(define (answer) 17)\n")
         (b "(define (answer) 29)\n"))
    (define (put text)
      (call-with-output-file (list path: input truncate: #t)
        (lambda (port) (display text port))))
    (put a)
    (compile-file-to-target input output: control)
    (dynamic-wind
      (lambda ()
        (set! ##read-all-as-a-begin-expr-from-path
          (lambda args
            (set! injected? #t)
            (put b)
            (dynamic-wind
              (lambda () #f)
              (lambda () (apply reader args))
              (lambda () (put a))))))
      (lambda ()
        (reuse-generated-c-closure! (list input) '() (string-append root "/published")
          (string-append root "/work") proof tool tools))
      (lambda () (set! ##read-all-as-a-begin-expr-from-path reader) (put a)))
    (if (not injected?) (error "race injector did not run"))
    (let ((same? (equal? (generation-file-sha tool output) (generation-file-sha tool control))))
      (reuse-generated-c-closure! (list input) '() (string-append root "/published")
        (string-append root "/repeat") proof tool tools)
      (if (not (null? (directory-files (string-append root "/repeat"))))
          (error "race control did not exercise proof reuse"))
      (if (equal? (getenv "GENERATION_EXPECT_SNAPSHOT" #f) "1")
          (if same? (display "SNAPSHOT-READ-RACE-CONTRACT-OK source-byte-parity repeat-hit\n")
              (error "snapshot reader compiled transient source bytes"))
          (if same? (error "old reader counterexample did not reproduce")
              (display "OLD-JOURNAL-TRANSIENT-SOURCE-COUNTEREXAMPLE wrong-C-proof-repeat-hit\n"))))))

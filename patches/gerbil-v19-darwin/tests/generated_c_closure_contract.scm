(define (run-generated-c-closure-contract!)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (implementation (getenv "GENERATION_IMPLEMENTATION"))
         (journal (getenv "GENERATION_JOURNAL"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (input (string-append root "/module.scm"))
         (dependency (string-append root "/value.scm"))
         (directory (string-append root "/published"))
         (output (string-append directory "/module.c"))
         (proof (string-append directory "/closure.proof"))
         (identity (string-append root "/tool.identity"))
         (tools (list (string-append bin "/gsc") hash-tool implementation journal
                      (getenv "GENERATION_CONTRACT") identity))
         (first-pinned #f) (first-pinned-sha #f)
         (count 0))
    (define (put path text)
      (call-with-output-file (list path: path truncate: #t)
        (lambda (port) (display text port))))
    (define (invoke options)
      (set! count (+ count 1))
      (let ((work (string-append root "/work-" (number->string count))))
        (create-directory work)
        (reuse-generated-c-closure! (list input) options directory work proof hash-tool tools)))
    (define (mark name) (display "GENERATED-C-CLOSURE-OK ") (display name) (newline))
    (create-directory directory)
    (put identity "tool-v1\n")
    (put dependency "(define dependency-value 17)\n")
    (put input "(include \"value.scm\")\n(define (answer) dependency-value)\n")
    (set! first-pinned (car (invoke '())))
    (set! first-pinned-sha (generation-file-sha hash-tool first-pinned))
    (let ((before (generation-file-sha hash-tool output)))
      (invoke '())
      (if (not (null? (directory-files (string-append root "/work-2"))))
          (error "repeat performed generation instead of hitting"))
      (if (not (equal? before (generation-file-sha hash-tool output))) (error "hit byte drift")))
    (mark "repeat-hit")
    (let ((original-pin generation-pin-outputs)
          (before (generation-file-sha hash-tool output))
          (old-proof (generation-file-sha hash-tool proof)))
      (dynamic-wind
        (lambda ()
          (set! generation-pin-outputs
            (lambda (tool entries scratch)
              (let ((result (original-pin tool entries scratch)))
                (put dependency "(define dependency-value 19)\n")
                result))))
        (lambda ()
          (if (not (with-exception-catcher (lambda (error) #t)
                     (lambda () (invoke '()) #f)))
              (error "mid-hit dependency mutation accepted"))
          (put dependency "(define dependency-value 23)\n")
          (if (not (with-exception-catcher (lambda (error) #t)
                     (lambda () (invoke '()) #f)))
              (error "pre-publication dependency mutation accepted")))
        (lambda ()
          (set! generation-pin-outputs original-pin)
          (put dependency "(define dependency-value 17)\n")))
      (if (or (not (equal? before (generation-file-sha hash-tool output)))
              (not (equal? old-proof (generation-file-sha hash-tool proof)))
              (file-exists? (string-append proof ".lock")))
          (error "mid-hit denial changed publication")))
    (mark "mid-hit-source-mutation-denied")
    (mark "pre-publication-source-mutation-denied")
    (let ((before (generation-file-sha hash-tool output))
          (source-sha (generation-file-sha hash-tool input)))
      (put dependency "(define dependency-value 29)\n")
      (invoke '())
      (if (or (equal? before (generation-file-sha hash-tool output))
              (not (equal? source-sha (generation-file-sha hash-tool input))))
          (error "dependency invalidation not observed")))
    (mark "transitive-source-invalidation")
    (if (or (not (equal? first-pinned-sha (generation-file-sha hash-tool first-pinned)))
            (equal? first-pinned-sha (generation-file-sha hash-tool output)))
        (error "old C consumer observes new publication"))
    (mark "retained-reader-content")
    (let* ((pinned (car (invoke '())))
           (before (generation-file-sha hash-tool output))
           (old-proof (generation-file-sha hash-tool proof)))
      (put pinned "corrupt snapshot\n")
      (if (not (with-exception-catcher (lambda (error) #t)
                 (lambda () (invoke '()) #f)))
          (error "corrupt snapshot accepted"))
      (if (or (not (equal? before (generation-file-sha hash-tool output)))
              (not (equal? old-proof (generation-file-sha hash-tool proof)))
              (file-exists? (string-append proof ".lock")))
          (error "snapshot denial changed publication"))
      ;; Restore only this test-owned injected corruption, outside the producer.
      (delete-file pinned)
      (copy-file output pinned))
    (mark "corrupt-pin-denied-preserves-publication")
    (put output "tampered\n")
    (invoke '())
    (compile-file-to-target input output: (string-append root "/module.c"))
    (if (not (equal? (generation-file-sha hash-tool output)
                    (generation-file-sha hash-tool (string-append root "/module.c"))))
        (error "tamper reconstruction differs from original"))
    (mark "output-tamper-parity")
    (let ((before (generation-file-sha hash-tool proof)))
      (invoke '((target C)))
      (if (equal? before (generation-file-sha hash-tool proof))
          (error "target option did not invalidate context"))
      (compile-file-to-target input options: '((target C))
        output: (string-append root "/module.c"))
      (if (not (equal? (generation-file-sha hash-tool output)
                      (generation-file-sha hash-tool (string-append root "/module.c"))))
          (error "target option byte parity failed"))
      (invoke '((target C)))
      (if (not (null? (directory-files (string-append root "/work-" (number->string count)))))
          (error "target option repeat did not hit")))
    (mark "explicit-target-parity-hit")
    (let ((before (generation-file-sha hash-tool proof)))
      (invoke '())
      (if (or (equal? before (generation-file-sha hash-tool proof))
              (null? (directory-files (string-append root "/work-" (number->string count)))))
          (error "different option identity incorrectly reused proof")))
    (mark "option-identity-invalidation")
    (put identity "tool-v2\n")
    (invoke '())
    (invoke '())
    (mark "tool-content-invalidation")
    (let ((old-proof (generation-file-sha hash-tool proof)))
      (setenv "GAMBIT_GENERATION_PRIVACY_FIXTURE" "private-context-value")
      (invoke '())
      (if (equal? old-proof (generation-file-sha hash-tool proof))
          (error "environment change did not invalidate proof"))
      (let ((record (call-with-input-file proof read)))
        (if (not (and (eq? (car record) 'generated-c-closure-v2)
                      (string? (cadr record)) (= (string-length (cadr record)) 64)))
            (error "proof stores raw context instead of digest")))
      (invoke '())
      (if (not (null? (directory-files (string-append root "/work-" (number->string count)))))
          (error "unchanged environment did not hit"))
      (setenv "GAMBIT_GENERATION_PRIVACY_FIXTURE")
      (invoke '()))
    (mark "private-context-environment-invalidation")
    (let ((before (generation-file-sha hash-tool output))
          (old-proof (generation-file-sha hash-tool proof)))
      (put dependency "(define dependency-value\n")
      (if (not (with-exception-catcher (lambda (error) #t)
                 (lambda () (invoke '()) #f))) (error "invalid dependency accepted"))
      (if (or (not (equal? before (generation-file-sha hash-tool output)))
              (not (equal? old-proof (generation-file-sha hash-tool proof)))
              (file-exists? (string-append proof ".lock")))
          (error "failed generation changed publication")))
    (mark "failure-preserves-publication")
    (put dependency "(define dependency-value 29)\n")
    (put input "(define-macro (constant) 41)\n(define (answer) (constant))\n")
    (invoke '())
    (if (file-exists? proof) (error "macro context was cached"))
    (mark "macro-fallback")
    (put input "(include \"value.scm\")\n(define (answer) dependency-value)\n")
    (invoke '())
    (if (file-exists? proof) (error "macro-contaminated process cached a later request"))
    (mark "macro-context-sticky")
    (put input "(define answer 17)\n(define answer 29)\n")
    (create-directory (string-append root "/diagnostic-control"))
    (let* ((port (open-output-string))
           (marker "GAMBIT-GENERATED-C-UNCACHEABLE\n")
           (original
             (begin
               (parameterize ((current-output-port port))
                 (compile-file-to-target input options: '((warnings))
                   output: (string-append root "/diagnostic-control/module.c")))
               (get-output-string port))))
      (if (= (string-length original) 0) (error "original warning fixture produced no diagnostics"))
      (for-each
        (lambda (round)
          (let ((port (open-output-string)))
            (parameterize ((current-output-port port)) (invoke '((warnings))))
            (let* ((actual (get-output-string port))
                   (size (- (string-length actual) (string-length marker))))
              (if (not (and (>= size 0)
                            (string=? (substring actual size (string-length actual)) marker)
                            (string=? (substring actual 0 size) original)))
                  (error "compiler diagnostic parity failed" round))))
          (if (file-exists? proof) (error "diagnostic fallback published a proof")))
        '(1 2)))
    (mark "repeat-diagnostic-parity")
    (put input "(include \"value.scm\")\n(define (answer) dependency-value)\n")
    (display "GENERATED-C-CLOSURE-CONTRACT-OK 15\n")))

(define (run-concurrent-generated-c-closure! suffix)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (tools (list (string-append bin "/gsc") hash-tool
                      (getenv "GENERATION_IMPLEMENTATION") (getenv "GENERATION_JOURNAL")
                      (getenv "GENERATION_CONTRACT") (string-append root "/tool.identity"))))
    (reuse-generated-c-closure! (list (string-append root "/module.scm")) '()
      (string-append root "/published") (string-append root "/concurrent-" suffix)
      (string-append root "/published/closure.proof") hash-tool tools)))

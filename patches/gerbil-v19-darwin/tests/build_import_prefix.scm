(define build-import-log-path (getenv "GERBIL_DIAGNOSTIC_IMPORT_LOG" #f))
(unless build-import-log-path (error "isolated import diagnostic log required"))
(define build-import-log (open-output-file build-import-log-path))
(define build-import-original (gx#current-expander-module-import))
(define build-import-depth 0)
(define build-phase-log (open-output-file (string-append build-import-log-path ".phases")))
(define build-phase-depth 0)
(define build-phase-totals (make-vector 6 0))
(define (build-phase-observer name original)
  (lambda (value)
    (if (> build-phase-depth 0)
        (original value)
        (let ((start (time->seconds (current-time)))
              (before (##process-statistics)))
          (dynamic-wind
           (lambda () (set! build-phase-depth 1))
           (lambda () (original value))
           (lambda ()
             (set! build-phase-depth 0)
             (let ((after (##process-statistics))
                   (base (if (eq? name 'eval) 0 3)))
               (vector-set! build-phase-totals base
                            (+ 1 (vector-ref build-phase-totals base)))
               (vector-set! build-phase-totals (+ base 1)
                            (+ (vector-ref build-phase-totals (+ base 1))
                               (- (time->seconds (current-time)) start)))
               (vector-set! build-phase-totals (+ base 2)
                            (+ (vector-ref build-phase-totals (+ base 2))
                               (- (f64vector-ref after 0) (f64vector-ref before 0))
                               (- (f64vector-ref after 1) (f64vector-ref before 1)))))))))))
;; Outermost evaluator/compiler calls form disjoint intervals, including their
;; nested work. This is diagnostic instrumentation, not a runtime replacement.
(gx#current-expander-eval
 (build-phase-observer 'eval (gx#current-expander-eval)))
(gx#current-expander-compile
 (build-phase-observer 'compile (gx#current-expander-compile)))
(gx#current-expander-module-import
 (lambda (path reload?)
   (let ((depth build-import-depth)
         (start (time->seconds (current-time)))
         (before (##process-statistics))
         (phases-before (vector-copy build-phase-totals))
         (completed? #f))
     (dynamic-wind
      (lambda () (set! build-import-depth (+ depth 1)))
      (lambda ()
        (let ((value (build-import-original path reload?)))
          (set! completed? #t)
          value))
      (lambda ()
        (set! build-import-depth depth)
        (let ((after (##process-statistics)))
          (display "IMPORT-PREFIX" build-import-log)
          (for-each
           (lambda (value) (display "\t" build-import-log) (write value build-import-log))
           (list depth path reload? completed?
                 (- (time->seconds (current-time)) start)
                 (- (f64vector-ref after 0) (f64vector-ref before 0))
                 (- (f64vector-ref after 1) (f64vector-ref before 1))))
          (newline build-import-log)
          (when (= depth 0)
            (write path build-phase-log)
            (let loop ((index 0))
              (when (< index 6)
                (display "\t" build-phase-log)
                (write (- (vector-ref build-phase-totals index)
                          (vector-ref phases-before index)) build-phase-log)
                (loop (+ index 1))))
            (newline build-phase-log)
            (force-output build-import-log)
            (force-output build-phase-log))))))))

(define root (getenv "RETAINED_ENTRY_ROOT"))
(define work (getenv "RETAINED_ENTRY_WORK"))
(define input (string-append work "/fixture.scm"))
(define output (string-append work "/transformed.scm"))
(call-with-output-file input
  (lambda (port)
    (write '(define (cleanup-probe)
              (cons _%output-c276294%_
                (cons _%output_-c276298%_
                  (cons _%output-o276296%_ (cons _%output_-o276300%_ '()))))) port)))
(setenv "FD_DRIVER_INPUT" input)
(setenv "FD_DRIVER_OUTPUT" output)
(load (string-append root "/patches/gerbil-v19-darwin/tests/prepare_retained_entry_driver.scm"))
(define platform? #f)
(define (gxc#darwin-gnu-source-loader-platform?) platform?)
(define _%output-c276294%_ "entry.c")
(define _%output_-c276298%_ "link.c")
(define _%output-o276296%_ "entry.o")
(define _%output_-o276300%_ "link.o")
(load output)
(define checks 0)
(for-each
  (lambda (row)
    (set! platform? (car row))
    (setenv "GAMBIT_DARWIN_STATIC_OBJECT_REUSE" (cadr row))
    (setenv "GAMBIT_DARWIN_RETAIN_ENTRY_OBJECTS" (caddr row))
    (let ((actual (cleanup-probe))
          (expected (if (and (car row) (equal? (cadr row) "1") (equal? (caddr row) "1"))
                        '("entry.c" "link.c") '("entry.c" "link.c" "entry.o" "link.o"))))
      (if (not (equal? actual expected)) (error "cleanup guard mismatch" row actual))
      (set! checks (+ checks 1))))
  '((#f "" "") (#f "1" "1") (#t "" "") (#t "1" "")
    (#t "" "1") (#t "1" "true") (#t "true" "1") (#t "1" "1")))
(display "RETAINED-ENTRY-GUARDS-OK checks=")
(write checks)
(newline)

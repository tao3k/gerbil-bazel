(define changed 0)
(define (prefix values count)
  (if (= count 0) '() (cons (car values) (prefix (cdr values) (- count 1)))))
(define (contains-runtime? tree)
  (cond ((equal? tree "-lgambit") #t)
        ((pair? tree) (or (contains-runtime? (car tree)) (contains-runtime? (cdr tree))))
        (else #f)))
(define (rewrite tree)
  (if (not (pair? tree)) tree
    (if (eq? (car tree) 'quote) tree
      (if (and (eq? (car tree) 'gxc#invoke__%) (= (length tree) 6)
               (equal? (list-ref tree 4) '(gxc#gerbil-gcc))
               (contains-runtime? (list-ref tree 5)))
        (begin
          (set! changed (+ changed 1))
          (append (prefix tree 5)
            (list
             `(let ((gb-link-args ,(list-ref tree 5)))
                (if (gxc#darwin-gnu-source-loader-platform?)
                  (let ((gb-runtime-object (##getenv "GAMBIT_DARWIN_RUNTIME_OBJECT" #f)))
                    (if gb-runtime-object (cons gb-runtime-object gb-link-args) gb-link-args))
                  gb-link-args)))))
        (cons (rewrite (car tree)) (rewrite (cdr tree)))))))
(call-with-input-file (getenv "FD_DRIVER_INPUT")
  (lambda (input)
    (call-with-output-file (getenv "FD_DRIVER_OUTPUT")
      (lambda (output)
        (let loop ()
          (let ((form (read input)))
            (if (not (eof-object? form))
              (begin (write (rewrite form) output) (newline output) (loop)))))))))
(if (not (= changed 2)) (error "exact two final runtime link sites required" changed))
(display "DRIVER-LINK-SITES ") (write changed) (newline)

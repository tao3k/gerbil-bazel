(define (run-member-contract! #!optional (instrumented? #t))
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (directory (string-append root "/published"))
         (left (string-append root "/left.scm"))
         (right (string-append root "/right.scm"))
         (include (string-append root "/value.scm"))
         (tool (string-append root "/tool.identity"))
         (tools (list (string-append bin "/gsc") hash-tool tool
                      (getenv "GENERATION_IMPLEMENTATION") (getenv "GENERATION_CONTRACT")))
         (count 0) (checks 0))
    (define (put path text)
      (call-with-output-file (list path: path truncate: #t)
        (lambda (port) (display text port))))
    (define (sha path) (c#generation-file-sha hash-tool path))
    (define (output input)
      (string-append directory "/" (path-strip-extension (path-strip-directory input)) ".c"))
    (define (proof input) (string-append (output input) ".gambit-member-proof"))
    (define (invoke inputs options)
      (set! count (+ count 1))
      (let ((work (string-append root "/work-" (number->string count))))
        (create-directory work)
        (reuse-generated-c-members! inputs options directory work hash-tool tools)))
    (define (mark name)
      (set! checks (+ checks 1))
      (display "MEMBER-PROOF-OK ") (display name) (newline))
    (define (reject thunk)
      (if (not (with-exception-catcher (lambda (exception) #t)
                 (lambda () (thunk) #f)))
          (error "expected member rejection")))
    (define (same-as-ordinary input)
      (let ((reference (string-append root "/" (path-strip-extension (path-strip-directory input)) ".c")))
        (if (not (compile-file-to-target input options: '((target C)) output: reference))
            (error "ordinary reference compilation failed"))
        (if (not (equal? (sha reference) (sha (output input))))
            (error "member C differs from ordinary" input))))
    (create-directory directory)
    (put tool "tool-v1\n")
    (put include "(define included-value 17)\n")
    (put left "(include \"value.scm\")\n(define (left-answer) included-value)\n")
    (put right "(define (right-answer) 31)\n")
    (let ((pins (invoke (list left right) '((target C)))))
      (same-as-ordinary left) (same-as-ordinary right)
      (if (not (equal? pins (invoke (list left right) '((target C)))))
          (error "repeat changed immutable pins"))
      (if (not (equal? (reverse pins) (invoke (list right left) '((target C)))))
          (error "request order was not preserved"))
      (if (not (equal? (list (car pins)) (invoke (list left) '((target C)))))
          (error "subset did not retain its own member")))
    (mark "population-repeat-order-subset-parity")
    (let ((old-right (sha (proof right))) (old-left (sha (proof left))))
      (put include "(define included-value 29)\n")
      (invoke (list left right) '((target C)))
      (same-as-ordinary left)
      (if (or (equal? old-left (sha (proof left)))
              (not (equal? old-right (sha (proof right)))))
          (error "include mutation did not invalidate exactly its member")))
    (mark "transitive-include-selective-invalidation")
    (let ((old-left (sha (proof left))) (old-right (sha (proof right))))
      (put right "(define (right-answer) 47)\n")
      (invoke (list left right) '((target C)))
      (same-as-ordinary right)
      (if (or (not (equal? old-left (sha (proof left))))
              (equal? old-right (sha (proof right))))
          (error "main source mutation did not invalidate exactly its member")))
    (mark "main-source-selective-invalidation")
    (let ((before (sha (proof left))))
      (invoke (list left right) '())
      (if (equal? before (sha (proof left))) (error "option identity did not invalidate")))
    (mark "option-invalidation")
    (let ((before (sha (proof left))))
      (put tool "tool-v2\n")
      (invoke (list left right) '())
      (if (equal? before (sha (proof left))) (error "tool content did not invalidate")))
    (mark "tool-content-invalidation")
    (let ((before (sha (proof left))))
      (setenv "MEMBER_PROOF_PRIVATE_CONTEXT" "private-value")
      (invoke (list left right) '())
      (if (equal? before (sha (proof left))) (error "environment did not invalidate")))
    (mark "environment-invalidation")
    (let ((old-c (sha (output right))) (old-proof (sha (proof right))))
      (put right "(define (bad-source\n")
      (reject (lambda () (invoke (list left right) '())))
      (if (or (not (equal? old-c (sha (output right))))
              (not (equal? old-proof (sha (proof right))))
              (file-exists? (string-append (proof right) ".lock")))
          (error "failed member replaced its prior publication"))
      (put right "(define (right-answer) 47)\n"))
    (mark "failed-member-preserves-C-proof-and-unlocks")
    ;; Mutate an earlier include after its validation, while consuming a later
    ;; member. The batch must reject even though both individual calls succeeded.
    ;; Compiled direct calls cannot be intercepted by rebinding this global.
    (if instrumented?
      (begin
    (let ((ordinary c#reuse-generated-c-closure!) (seen 0))
      (dynamic-wind
        (lambda ()
          (set! c#reuse-generated-c-closure!
            (lambda args
              (let ((result (apply ordinary args)))
                (set! seen (+ seen 1))
                (if (= seen 2) (put include "(define included-value 53)\n"))
                result))))
        (lambda () (reject (lambda () (invoke (list left right) '()))))
        (lambda () (set! c#reuse-generated-c-closure! ordinary))))
    (mark "earlier-include-mid-batch-mutation-denied")
    (let ((ordinary c#reuse-generated-c-closure!) (seen 0))
      (dynamic-wind
        (lambda ()
          (set! c#reuse-generated-c-closure!
            (lambda args
              (let ((result (apply ordinary args)))
                (set! seen (+ seen 1))
                (if (= seen 2) (put tool "tool-v3\n"))
                result))))
        (lambda () (reject (lambda () (invoke (list left right) '()))))
        (lambda () (set! c#reuse-generated-c-closure! ordinary))))
    (mark "late-tool-mutation-denied")))
    (let* ((pins (invoke (list left right) '()))
           (old-c (sha (output left))) (old-proof (sha (proof left))))
      (put (car pins) "corrupt immutable C\n")
      (reject (lambda () (invoke (list left right) '())))
      (if (or (not (equal? old-c (sha (output left))))
              (not (equal? old-proof (sha (proof left)))))
          (error "pin denial replaced prior publication"))
      (delete-file (car pins)) (copy-file (output left) (car pins)))
    (mark "corrupt-pin-denied")
    (reject (lambda () (invoke (list left left) '())))
    (mark "duplicate-target-denied")
    (setenv "GAMBIT_DARWIN_CLOSED_LINK_MEMBER_PROOF" "0")
    (reject (lambda () (invoke (list left right) '())))
    (setenv "GAMBIT_DARWIN_CLOSED_LINK_MEMBER_PROOF" "1")
    (mark "flag-off-denied")
    (put left "(define-macro (unsafe-macro) 17)\n(define value (unsafe-macro))\n")
    (reject (lambda () (invoke (list left right) '())))
    (mark "source-macro-context-not-admitted")
    (put left "(include \"value.scm\")\n(define (left-answer) included-value)\n")
    (display "MEMBER-PROOF-CONTRACT-OK ") (write checks) (newline)))

(define (run-member-concurrent! role)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (inputs (list (string-append root "/left.scm") (string-append root "/right.scm")))
         (requested (if (string=? role "a") inputs (reverse inputs)))
         (tools (list (string-append bin "/gsc") hash-tool
                      (string-append root "/tool.identity")
                      (getenv "GENERATION_IMPLEMENTATION") (getenv "GENERATION_CONTRACT")))
         (pins (reuse-generated-c-members! requested '((target C))
                 (string-append root "/published")
                 (string-append root "/concurrent-" role) hash-tool tools)))
    (for-each
      (lambda (input pin)
        (let ((reference (string-append root "/concurrent-" role "/"
                           (path-strip-extension (path-strip-directory input)) ".c")))
          (if (not (compile-file-to-target input options: '((target C)) output: reference))
              (error "concurrent ordinary compilation failed"))
          (if (not (equal? (c#generation-file-sha hash-tool reference)
                          (c#generation-file-sha hash-tool pin)))
              (error "concurrent pin order or bytes differ"))))
      requested pins)
    (display "MEMBER-PROOF-CONCURRENT-OK ") (display role) (newline)))

;; Qualification prototype: the existing GSC APIs, one process, same outputs.
(let* ((source (getenv "GAMBIT_COMPOUND_SOURCE"))
       (runtime-c (getenv "GAMBIT_COMPOUND_RUNTIME_C"))
       (static-c (getenv "GAMBIT_COMPOUND_STATIC_C"))
       (static-o (getenv "GAMBIT_COMPOUND_STATIC_O"))
       (module-ref (getenv "GAMBIT_COMPOUND_MODULE_REF"))
       (cc-options (getenv "GAMBIT_COMPOUND_CC_OPTIONS"))
       (options (list '(target C)
                      (list 'module-ref (string->symbol module-ref))
                      (list 'linker-name module-ref))))
  (if (not (compile-file-to-target source options: options output: runtime-c))
      (error "Compound producer C generation failed"))
  (if (file-exists? static-c) (delete-file static-c))
  (copy-file runtime-c static-c)
  (if (not (compile-file static-c options: '((obj)) output: static-o
                         cc-options: cc-options))
      (error "Compound producer object compilation failed"))
  (display "GAMBIT-COMPOUND-PRODUCER-OK\n"))
(exit 0)

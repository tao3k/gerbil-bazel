(define (member-external-setup!)
  (let ((root (getenv "GENERATION_FIXTURE")))
    (define (put name text)
      (call-with-output-file (string-append root "/" name)
        (lambda (port) (display text port))))
    (create-directory (string-append root "/published"))
    (put "value.scm" "(define included-value 17)\n")
    (put "tool.identity" "tool-v1\n")
    (put "left.scm" "(include \"value.scm\")\n(define (left-answer) included-value)\n")
    ;; Real compiler work keeps the second member active for external mutation.
    (call-with-output-file (string-append root "/right.scm")
      (lambda (port)
        (let loop ((index 0))
          (if (< index 4000)
              (begin
                (write `(define (,(string->symbol (string-append "right-" (number->string index))) x)
                          (+ x ,index)) port)
                (newline port)
                (loop (+ index 1)))))))
    (display "MEMBER-EXTERNAL-SETUP-OK\n")))

(define (member-external-pad-c!)
  (call-with-output-file
    (list path: (string-append (getenv "GENERATION_FIXTURE") "/second/right.c") append: #t)
    (lambda (port)
      (display "\n/*" port)
      (let ((chunk (make-string 65536 #\space)))
        (let loop ((remaining 512))
          (if (> remaining 0)
              (begin (display chunk port) (loop (- remaining 1))))))
      (display "*/\n" port))))

(define (member-external-run! phase)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (inputs (map (lambda (name) (string-append root "/" name))
                      '("left.scm" "right.scm")))
         (tools (list (string-append bin "/gsc") hash-tool
                      (string-append root "/tool.identity")))
         (work (string-append root "/" phase)))
    (create-directory work)
    (let ((pins (c#reuse-generated-c-members! inputs '((target C))
                  (string-append root "/published") work hash-tool tools)))
      (if (string=? phase "retry")
          (for-each
            (lambda (input pin)
              (let ((reference (string-append work "/"
                                  (path-strip-extension (path-strip-directory input)) ".c")))
                (if (not (compile-file-to-target input options: '((target C)) output: reference))
                    (error "ordinary retry reference failed"))
                (if (not (equal? (c#generation-file-sha hash-tool reference)
                                (c#generation-file-sha hash-tool pin)))
                    (error "failed batch poisoned retry" input)))) inputs pins))
      (display "MEMBER-EXTERNAL-RUN-OK ") (display phase) (newline))))

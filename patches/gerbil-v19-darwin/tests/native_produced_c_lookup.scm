(define (run-native-produced-c-lookup!)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (tools (list (path-normalize (executable-path)) hash-tool))
         (inputs (call-with-input-file (string-append root "/ordered-inputs.txt")
                   (lambda (port)
                     (let loop ((result '()))
                       (let ((line (read-line port)))
                         (if (eof-object? line) (reverse result) (loop (cons line result))))))))
         (directory (string-append root "/published")))
    (if (not (= (length inputs) 55)) (error "unexpected native producer inventory"))
    (let* ((requests
            (let loop ((inputs inputs) (index 0) (result '()))
              (if (null? inputs) (reverse result)
                  (let* ((static (car inputs))
                         (alias (path-strip-extension (path-strip-directory static)))
                         (name (string-append "producer-" (number->string index)))
                         (dynamic (string-append root "/dynamic/" name ".scm"))
                         (options (list '(target C) (list 'module-ref (string->symbol alias))
                                        (list 'linker-name alias))))
                    (loop (cdr inputs) (+ index 1)
                      (cons (list static dynamic options directory
                                   (string-append directory "/" name ".c.generation-proof")) result))))))
           (start (time->seconds (current-time)))
           (pins (c#lookup-produced-generated-c-batch requests (string-append root "/lookup") hash-tool tools)))
      (if (not pins) (error "native producer batch not admitted"))
      (display "NATIVE-PRODUCED-C lookup ")
      (write (- (time->seconds (current-time)) start)) (newline)
      (call-with-output-file (string-append root "/pinned-inputs.txt")
        (lambda (port) (for-each (lambda (pin) (display pin port) (newline port)) pins)))
      (display "NATIVE-PRODUCED-C-LOOKUP-OK 55\n"))))

(define (stdlib-emit-hash-layout!)
  (let ((seen (make-hash-table-eq)) (snapshots '()) (next-id 0))
    (hash-for-each
      (lambda (name ctx)
        (when (and (gx#module-context? ctx) (not (hash-get seen ctx)))
          (hash-put! seen ctx #t)
          (let* ((tab (let unwrap ((value (gx#expander-context-table ctx)))
                        (if (interface-instance? value)
                          (unwrap (interface-instance-object value)) value)))
                 (checked (unless (and (##structure? tab)
                                    (let parent ((type (##structure-type tab)))
                                      (and type (or (eq? type __gc-table::t)
                                                    (parent (##type-super type))))))
                            (error "GC table required for physical snapshot")))
                 (gcht (__gc-table-e tab))
                 (size (##gc-hash-table-length gcht))
                 (keys (make-vector (quotient (- size 5) 2))))
            ;; Normalize pending moved-key rehash before copying physical slots.
            (##gc-hash-table-ref gcht 'stdlib-layout-miss)
            (let ((before (f64vector-ref (##process-statistics) 6)))
              (let loop ((i 0))
                (when (< i (vector-length keys))
                  (vector-set! keys i
                    (##object->encoding (##gc-hash-table-field-ref gcht (+ 5 (* i 2)))))
                  (loop (+ i 1))))
              (let ((after (f64vector-ref (##process-statistics) 6)))
                (unless (= before after) (error "GC during physical table snapshot"))
                (set! snapshots
                  (cons (list next-id size (##gc-hash-table-field-ref gcht 1)
                              (##gc-hash-table-field-ref gcht 2) keys) snapshots))
                (set! next-id (+ next-id 1)))))))
      gx#__module-registry)
    (for-each
      (lambda (snapshot)
        (display "STDLIB-HASH-TABLE\t")
        (write (car snapshot))
        (for-each (lambda (value) (display "\t") (write value))
                  (list (cadr snapshot) (caddr snapshot) (cadddr snapshot)))
        (newline)
        (let ((keys (car (cddddr snapshot))))
          (let loop ((i 0))
            (when (< i (vector-length keys))
              (display "STDLIB-HASH-SLOT\t") (write (car snapshot))
              (display "\t") (write i)
              (display "\t") (write (vector-ref keys i)) (newline)
              (loop (+ i 1))))))
      (reverse snapshots))
    (displayln "STDLIB-HASH-LAYOUT-OK")))

(define stdlib-current-phase 'none)
(define stdlib-process-budget? #f)
(define (stdlib-emit-process-budget phase before after)
  (display "STDLIB-BUDGET\t") (display phase)
  (for-each
    (lambda (index)
      (display "\t")
      (write (- (f64vector-ref after index) (f64vector-ref before index))))
    '(0 1 2 3 4 5 6 7 10 11))
  (for-each
    (lambda (index) (display "\t") (write (f64vector-ref after index)))
    '(15 16 17 18 19))
  (newline) (force-output))
(define (stdlib-import-cost name . observers)
  (define (measure phase thunk)
    (set! stdlib-current-phase phase)
    (let* ((before (and stdlib-process-budget? (##process-statistics)))
           (start (time->seconds (current-time)))
           (value (thunk))
           (elapsed (- (time->seconds (current-time)) start))
           (after (and stdlib-process-budget? (##process-statistics))))
      (when stdlib-process-budget?
        (stdlib-emit-process-budget phase before after))
      (display "STDLIB-PHASE\t") (display phase) (display "\t")
      (write elapsed) (newline) (force-output)
      value))
  (when (hash-get gx#__module-registry name)
    (error "root already imported before diagnostic" name))
  (let ((ctx (measure 'import (lambda () (gx#import-module name #f #f)))))
    (unless (gx#module-context? ctx) (error "module context required" name))
    (measure 'eval (lambda () (gx#eval-module ctx)))
    (let ((again (measure 'cached-import
                  (lambda () (gx#import-module name #f #f)))))
      (unless (eq? ctx again) (error "cached import context identity changed" name)))
    (measure 'cached-eval (lambda () (gx#eval-module ctx)))
    (for-each
      (lambda (out)
        (display "STDLIB-EXPORT\t") (write (gx#module-export-name out))
        (display "\t") (write (gx#module-export-phi out)) (newline))
      (gx#module-context-export ctx))
    (for-each
      (lambda (entry)
        (display "STDLIB-MODULE\t") (write (car entry)) (display "\t")
        (write (if (eq? (cdr entry) 'builtin) 'builtin
                   (if (string? (cdr entry)) 'loaded 'unexpected)))
        (newline))
      (list-modules))
    (for-each (lambda (emit) (emit)) observers)
    (displayln "CONTEXT-IDENTITY-OK")
    (displayln "OK")))

;; Keep the frozen private loader and all other driver entry points intact.
(define recipe? (equal? (getenv "CLOSED_DRIVER_RECIPE" #f) "1"))
(define base? (equal? (getenv "CLOSED_DRIVER_MODULE" #f) "base"))
(define added-names
  (if (and recipe? base?)
      '(gxc#add-compile-output-job!__1 gxc#current-compile-output-recipe)
      '()))
(define selected-names
  (cond
    ((and recipe? base?)
     '(gxc#open-compile-executor gxc#add-compile-output-job!__%
       gxc#add-compile-output-job!__0 gxc#add-compile-output-job!
       gxc#add-compile-output-job!__1 gxc#current-compile-output-recipe))
    (recipe?
     '(gxc#compile-executable-module/separate gxc#gsc-compile-file
       gxc#compile-scm-file__%))
    ((equal? (getenv "CLOSED_DRIVER_PRODUCER" #f) "1")
     '(gxc#compile-executable-module/separate gxc#gsc-compile-file))
    (else '(gxc#compile-executable-module/separate))))
(if (and base? (not recipe?)) (error "base merge requires recipe mode"))
(define (read-forms path)
  (call-with-input-file path
    (lambda (input)
      (let loop ((forms '()))
        (let ((form (read input)))
          (if (eof-object? form) (reverse forms)
              (loop (cons form forms))))))))
(define (selected? tree)
  (and (pair? tree) (eq? (car tree) 'define) (pair? (cdr tree))
       (memq (cadr tree) selected-names)))
(define (definitions tree)
  (cond ((not (pair? tree)) '())
        ((eq? (car tree) 'quote) '())
        ((selected? tree) (list tree))
        (else (append (definitions (car tree)) (definitions (cdr tree))))))
(define original (read-forms (getenv "CLOSED_DRIVER_BASE")))
(define donor (read-forms (getenv "CLOSED_DRIVER_DONOR")))
(define original-selected (definitions original))
(define donor-selected (definitions donor))
(for-each
  (lambda (name)
    (if (not (and (= (length (filter (lambda (form) (eq? (cadr form) name)) original-selected))
                     (if (memq name added-names) 0 1))
                  (= (length (filter (lambda (form) (eq? (cadr form) name)) donor-selected)) 1)))
        (error "exactly one selected compiler definition required" name)))
  selected-names)
(define (replace tree replacement)
  (cond ((not (pair? tree)) tree)
        ((eq? (car tree) 'quote) tree)
        ((selected? tree) (cdr (assoc (cadr tree) replacement)))
        (else (cons (replace (car tree) replacement)
                    (replace (cdr tree) replacement)))))
(define result (replace original (map (lambda (form) (cons (cadr form) form)) donor-selected)))
(define (insert-added tree)
  (cond ((not (pair? tree)) tree)
        ((eq? (car tree) 'quote) tree)
        ((and (pair? (car tree)) (selected? (car tree))
              (eq? (cadar tree) 'gxc#add-compile-output-job!))
         (append (map (lambda (name) (car (filter (lambda (form) (eq? (cadr form) name)) donor-selected)))
                      added-names)
                 (cons (car tree) (insert-added (cdr tree)))))
        (else (cons (insert-added (car tree)) (insert-added (cdr tree))))))
(when (pair? added-names) (set! result (insert-added result)))
(for-each
  (lambda (name)
    (if (not (= (length (filter (lambda (form) (eq? (cadr form) name)) (definitions result))) 1))
        (error "exactly one merged compiler definition required" name)))
  selected-names)
(define (erase-added tree)
  (cond ((not (pair? tree)) tree)
        ((eq? (car tree) 'quote) tree)
        ((and (selected? (car tree)) (memq (cadar tree) added-names))
         (erase-added (cdr tree)))
        (else (cons (erase-added (car tree)) (erase-added (cdr tree))))))
(define erased (map (lambda (name) (cons name #f)) selected-names))
(if (not (equal? (replace original erased) (replace (erase-added result) erased)))
    (error "unselected frozen driver forms changed"))
(define output-path (getenv "CLOSED_DRIVER_OUTPUT"))
(if (file-exists? output-path) (error "fresh driver output required"))
(call-with-output-file output-path
  (lambda (output)
    (for-each (lambda (form) (write form output) (newline output)) result)))
(display "CLOSED-AOT-DRIVER-MERGE-OK definitions=")
(write (length selected-names))
(display " frozen-remainder-preserved")
(newline)

(define (run-real-generated-c-alias!)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (input (string-append root "/module.scm"))
         (directory (string-append root "/published"))
         (proof (string-append directory "/closure.proof"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (tools (list (string-append bin "/gsc") hash-tool
                      (getenv "GENERATION_JOURNAL") (getenv "GENERATION_IMPLEMENTATION")
                      (getenv "GENERATION_CONTRACT"))))
    (define (invoke name work)
      (reuse-generated-c-closure! (list input)
        (list (list 'module-ref (string->symbol name)) (list 'linker-name name) '(target C))
        directory (string-append root "/" work) proof hash-tool tools))
    (define (verify name)
      (if (not (equal? (generation-file-sha hash-tool (string-append root "/control/" name "/module.c"))
                      (generation-file-sha hash-tool (string-append directory "/module.c"))))
          (error "CLI/API explicit alias byte mismatch" name)))
    (let* ((first (invoke "alias-first" "work-first"))
           (old-proof (generation-file-sha hash-tool proof)))
      (verify "alias-first")
      (if (not (equal? first (invoke "alias-first" "work-hit")))
          (error "alias repeat changed pin"))
      (if (not (null? (directory-files (string-append root "/work-hit"))))
          (error "alias repeat performed generation"))
      (let ((second (invoke "alias-second" "work-second")))
        (verify "alias-second")
        (if (or (equal? first second) (equal? old-proof (generation-file-sha hash-tool proof)))
            (error "alias change failed to invalidate identity"))
        (if (not (equal? (generation-file-sha hash-tool (car first))
                        (generation-file-sha hash-tool (string-append root "/control/alias-first/module.c"))))
            (error "alias change damaged prior reader"))))
    (for-each (lambda (options)
                (if (generation-supported-options? options)
                    (error "unsupported alias options admitted" options)))
      '(((module-ref alias-first))
        ((linker-name "alias-first"))
        ((module-ref alias-first) (linker-name "alias-second"))
        ((target C) (target C))
        ((module-ref alias-first) (linker-name "alias-first") (debug-source))))
    (display "REAL-GENERATED-C-ALIAS-OK parity hit invalidation retained-reader rejected-options\n")))

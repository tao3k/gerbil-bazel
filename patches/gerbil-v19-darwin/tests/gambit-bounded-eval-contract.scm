(##eval
 '(let ((checks 0))
    (define (check value)
      (if (not value) (error "bounded eval contract failed"))
      (set! checks (+ checks 1)))
    (define (make-items n)
      (let loop ((n n) (xs '()))
        (if (= n 0) xs (loop (- n 1) (cons (vector n) xs)))))
    (let round ((r 0))
      (if (< r 3)
          (begin
            (let loop ((n 0))
              (if (<= n 80)
                  (let* ((xs (make-items n))
                         (ys (reverse xs)))
                    (check (= (length xs) n))
                    (check (= (##length xs) n))
                    (check (equal? (reverse ys) xs))
                    (check (equal? (##reverse ys) xs))
                    (if (> n 0)
                        (begin
                          (check (not (eq? xs ys)))
                          (check (eq? (car xs) (car (##reverse ys))))))
                    (if (= (modulo n 7) 0) (##gc))
                    (loop (+ n 1)))))
            (round (+ r 1)))))
    (check (= (##length '(1 2 . 3)) 2))
    (check (equal? (##reverse '(1 2 . 3)) '(2 1)))
    (let* ((root (##structure #f 'root "root" 0 #f '#()))
           (child (##structure #f 'child "child" 0 root '#()))
           (obj (##structure child 42)))
      (let loop ((n 0))
        (if (< n 300)
            (begin
              (check (##structure-instance-of? obj 'root))
              (check (##structure-instance-of? obj 'child))
              (check (not (##structure-direct-instance-of? obj 'root)))
              (check (##structure-direct-instance-of? obj 'child))
              (check (not (##structure-instance-of? obj 'missing)))
              (check (not (##structure-instance-of? 1 'root)))
              (if (= (modulo n 20) 0) (##gc))
              (loop (+ n 1)))))
      (##unchecked-structure-set! child #f 4 #f #f)
      (check (not (##structure-instance-of? obj 'root)))
      (##unchecked-structure-set! child 'changed 1 #f #f)
      (check (##structure-direct-instance-of? obj 'changed)))
    (display "BOUNDED-EVAL-OK ")
    (display checks)
    (newline)))

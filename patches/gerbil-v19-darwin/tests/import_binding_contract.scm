;; Original native behavior required by any bulk interface-construction candidate.
(define contract-count 0)
(define (check name value)
  (unless value (error "import binding contract failed" name))
  (set! contract-count (+ contract-count 1))
  (display "IMPORT-BINDING-CASE\t") (write name) (newline))
(define (context id)
  (gx#make-module-context id #f id "contract-source"))
(define source (context 'source))
(define target-a (context 'target-a))
(define target-b (context 'target-b))
(define original-binding (gx#make-runtime-binding 'binding-id 'key 0))
(gx#core-context-put! source 'key original-binding)
(define export (gx#make-module-export source 'key 0 'key #f))
(define in (gx#make-module-import export 'key 0 #f))
(define init-slot (##make-global-var 'gx#import-binding:::init!))
(define original-init (##global-var-ref init-slot))
(define init-calls 0)
(define init-wrapper
  (lambda (self id key phi e ctx weak?)
    (set! init-calls (+ init-calls 1))
    (original-init self id key phi e ctx weak?)))
(define (raises? thunk)
  (with-exception-catcher (lambda (e) #t) (lambda () (thunk) #f)))
(dynamic-wind
  (lambda () (##global-var-set! init-slot init-wrapper))
  (lambda ()
    (parameterize ((gx#current-expander-allow-rebind? #f))
      (gx#core-bind-import! in target-a #f)
      (check 'initializer-eager (= init-calls 1))
      (gx#core-bind-import! in target-b #f)
      (check 'initializer-per-context (= init-calls 2))
      (let ((a (gx#core-context-get target-a 'key))
            (b (gx#core-context-get target-b 'key)))
        (check 'fresh-bindings (and (gx#import-binding? a)
                                   (gx#import-binding? b) (not (eq? a b))))
        (check 'same-resolved-source
          (and (eq? (gx#import-binding-e a) original-binding)
               (eq? (gx#import-binding-e b) original-binding)))
        (gx#binding-properties-set! a '(probe: 1))
        (check 'properties-isolated (not (gx#binding-properties b)))
        (gx#core-bind-import! in target-a #f)
        (check 'same-id-keeps-prior (eq? a (gx#core-context-get target-a 'key)))
        (check 'initializer-even-if-prior-kept (= init-calls 3))
        (let* ((other (gx#make-runtime-binding 'other-id 'other 0))
               (other-export (gx#make-module-export source 'other 0 'other #f))
               (other-in (gx#make-module-import other-export 'key 0 #f)))
          (gx#core-context-put! source 'other other)
          (check 'strong-conflict-raises
            (raises? (lambda () (gx#core-bind-import! other-in target-a #f))))
          (check 'conflict-initializer-eager (= init-calls 4))
          (check 'conflict-preserves-prior
            (eq? a (gx#core-context-get target-a 'key)))
          (gx#core-bind-import! other-in target-a #t)
          (check 'weak-does-not-replace-strong
            (eq? a (gx#core-context-get target-a 'key))))
        (let ((sentinel (list 'initializer-error))
              (throw-target (context 'throw-target)))
          (##global-var-set! init-slot
            (lambda args (raise sentinel)))
          (check 'initializer-error-propagates
            (with-exception-catcher (lambda (e) (eq? e sentinel))
              (lambda () (gx#core-bind-import! in throw-target #f) #f)))
          (check 'initializer-error-before-insertion
            (not (gx#core-context-get throw-target 'key)))
          (##global-var-set! init-slot init-wrapper)))))
  (lambda () (##global-var-set! init-slot original-init)))
(check 'initializer-restored (eq? original-init (##global-var-ref init-slot)))
(let* ((replacement (gx#make-runtime-binding 'replacement-id 'key 0))
       (fresh-target (context 'fresh-target))
       (previous (gx#core-context-get target-a 'key)))
  (dynamic-wind
    (lambda () (gx#core-context-put! source 'key replacement))
    (lambda ()
      (gx#core-bind-import! in fresh-target #f)
      (check 'export-resolved-again
        (eq? replacement
             (gx#import-binding-e (gx#core-context-get fresh-target 'key))))
      (check 'prior-import-keeps-source-binding
        (eq? original-binding (gx#import-binding-e previous))))
    (lambda () (gx#core-context-put! source 'key original-binding))))
(let* ((effect-target (context 'effect-target))
       (injected (gx#make-runtime-binding 'injected-id 'key 0)))
  (dynamic-wind
    (lambda ()
      (##global-var-set! init-slot
        (lambda (self id key phi e ctx weak?)
          (original-init self id key phi e ctx weak?)
          (gx#core-context-put! effect-target 'key injected))))
    (lambda ()
      (parameterize ((gx#current-expander-allow-rebind? #f))
        (check 'initializer-mutation-before-conflict
          (raises? (lambda () (gx#core-bind-import! in effect-target #f))))
        (check 'initializer-mutation-preserved
          (eq? injected (gx#core-context-get effect-target 'key)))))
    (lambda () (##global-var-set! init-slot original-init))))
(check 'effect-controls-restored
  (and (eq? original-binding (gx#core-context-get source 'key))
       (eq? original-init (##global-var-ref init-slot))))
(let* ((raw-target (context 'raw-key-target))
       (raw-key (list 'public-context-key))
       (first (list 'first-value))
       (second (list 'second-value))
       (callback-count 0))
  (gx#core-context-put! raw-target raw-key first)
  (check 'context-nonsymbol-key-live
    (eq? first (gx#core-context-get raw-target raw-key)))
  (check 'context-nonsymbol-key-eq
    (not (gx#core-context-get raw-target (list 'public-context-key))))
  (gx#core-context-bind! raw-target raw-key second
    (lambda (prior)
      (unless (eq? prior first) (error "prior context value changed"))
      (set! callback-count (+ callback-count 1))
      second))
  (check 'context-nonsymbol-rebind-effect
    (and (= callback-count 1) (eq? second (gx#core-context-get raw-target raw-key)))))
(let* ((marked-target (context 'marked-target))
       (mark (gx#make-expander-mark #f marked-target 0 #f))
       (binding (gx#make-runtime-binding 'marked-binding 'marked-key 0)))
  (gx#core-bind! (cons 'marked-key mark) binding gx#core-context-rebind? 0 marked-target)
  (let ((key (hash-get (gx#expander-mark-subst mark) 'marked-key)))
    (check 'marked-key-substitutes-symbol
      (and (symbol? key) (uninterned-symbol? key)
           (eq? binding (gx#core-context-get marked-target key))))
    (check 'marked-key-resolves-live
      (eq? binding (gx#core-resolve-binding 'marked-key 0 0 marked-target (list mark))))
    (let ((before (symbolic-hash key)))
      (##gc)
      (check 'gensym-symbolic-hash-after-gc
        (and (= before (symbolic-hash key))
             (eq? binding (gx#core-context-get marked-target key)))))))
(let* ((head-target (context 'head-target))
       (head (gensym 'head))
       (form (list head 1))
       (replacement (gx#make-runtime-binding 'head-runtime head 0))
       (calls 0)
       (expander (gx#make-macro-expander
                   (lambda (stx) (set! calls (+ calls 1)) stx)))
       (initial (gx#make-syntax-binding 'head-macro head 0 expander))
       (slot (##make-global-var 'gx#resolve-identifier))
       (original (##global-var-ref slot))
       (resolutions 0))
  (gx#core-context-put! head-target head initial)
  (dynamic-wind
    (lambda ()
      (##global-var-set! slot
        (lambda args
          (let ((value (apply original args)))
            (when (eq? (car args) head)
              (set! resolutions (+ resolutions 1))
              (when (= resolutions 1)
                (gx#core-context-put! head-target head replacement)))
            value))))
    (lambda ()
      (parameterize ((gx#current-expander-context head-target)
                     (gx#current-expander-phi 0)
                     (gx#current-expander-marks '()))
        (check 'head-native-macro-returns-original-form
          (eq? form (gx#core-expand-head form)))
        (check 'head-public-resolver-wrapper-not-reached (= resolutions 0))
        (check 'head-original-macro-applied-once (= calls 1))))
    (lambda () (##global-var-set! slot original)))
  (check 'head-resolver-restored (eq? original (##global-var-ref slot))))
(let* ((target (context 'head-stop-target))
       (head (gensym 'head-stop))
       (form (list head))
       (initial-expander (gx#make-special-form (lambda (stx) stx) 'initial #f))
       (next-expander (gx#make-special-form (lambda (stx) stx) 'next #f))
       (initial (gx#make-syntax-binding '%#begin head 0 initial-expander))
       (next (gx#make-syntax-binding 'next-special head 0 next-expander))
       (slot (##make-global-var 'gx#core-expander?))
       (original (##global-var-ref slot))
       (predicate-calls 0)
       (handler-calls 0)
       (observed #f))
  (gx#core-context-put! target head initial)
  (dynamic-wind
    (lambda ()
      (##global-var-set! slot
        (lambda (value)
          (let ((result (original value)))
            (when (eq? value initial-expander)
              (set! predicate-calls (+ predicate-calls 1))
              (gx#core-context-put! target head next))
            result))))
    (lambda ()
      (parameterize ((gx#current-expander-context target)
                     (gx#current-expander-phi 0)
                     (gx#current-expander-marks '()))
        (let ((result
               (gx#core-expand-block (list 'synthetic-begin form)
                 (lambda (hd K rest rbody)
                   (set! handler-calls (+ handler-calls 1))
                   (set! observed (gx#resolve-identifier head))
                   (K rest (cons hd rbody))) #f)))
          (check 'head-stop-live-predicate-reached (= predicate-calls 1))
          (check 'head-stop-caller-sees-new-binding (eq? observed next))
          (check 'head-stop-new-special-handler-selected (= handler-calls 1))
          (check 'head-stop-original-body-preserved (equal? result (list form))))))
    (lambda () (##global-var-set! slot original)))
  (check 'head-stop-predicate-restored (eq? original (##global-var-ref slot))))
(display "IMPORT-BINDING-OK\t") (write contract-count) (newline)

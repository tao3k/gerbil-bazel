(define bundle-init-log '())
(define (run-multi-entry-bundle-contract!)
  (let* ((root (getenv "BUNDLE_FIXTURE"))
         (grouped? (equal? (getenv "BUNDLE_MODE") "grouped"))
         (reverse? (equal? (getenv "BUNDLE_ORDER") "reverse"))
         (order (if reverse? '(beta alpha) '(alpha beta)))
         (callbacks '()))
    (##load (string-append root "/counter.o1") (lambda (line path) #f) #t #t #f #t)
    (let ((before (bundle-image-count)))
      (define (invoke name)
        (let ((alias (symbol->string name)))
          (##load (string-append root "/" (if grouped? "grouped" "individual") "/" alias ".o1")
            (lambda (line path) (set! callbacks (cons name callbacks)))
            #t #t #f #t)))
      (invoke (car order))
      (if (not (equal? bundle-init-log (list (car order))))
          (error "bundle eagerly initialized an unrequested module" bundle-init-log))
      (invoke (cadr order))
      (if (not (equal? bundle-init-log (reverse order)))
          (error "bundle initialization order changed" bundle-init-log))
      (if (not (and (= (bundle-alpha-answer) 17) (= (bundle-beta-answer) 29)))
          (error "bundle module return values changed"))
      (let ((alpha (bundle-alpha-reader)) (beta (bundle-beta-reader)))
        (bundle-alpha-set! 41)
        (if (not (and (= (alpha) 41) (= (beta) 29)))
            (error "alpha mutation leaked into beta"))
        (bundle-beta-set! 53)
        (if (not (and (= (alpha) 41) (= (beta) 53)))
            (error "beta mutation leaked into alpha")))
      (let ((repeated
              (with-exception-catcher
                (lambda (exc)
                  (if (not (os-exception? exc)) (raise exc))
                  (call-with-input-string
                    (call-with-output-string
                      (lambda (port) (display-exception exc port)))
                    read-line))
                (lambda () (invoke (car order)) #f))))
        (if (not (and repeated
                      (equal? repeated "Can't load a given object file more than once")))
            (error "repeat-load rejection changed" repeated)))
      (if (not (equal? bundle-init-log (reverse order)))
          (error "repeat reinitialized module"))
      (if (not (equal? callbacks (reverse order)))
          (error "script callback contract changed" callbacks))
      (let ((delta (- (bundle-image-count) before)))
        (if (not (= delta (if grouped? 1 2)))
            (error "unexpected physical image count" delta))
        (let ((missing (##load-object-file (string-append root "/combined.o1") "missing" #t)))
          (if (not (and (vector? missing) (= (vector-length missing) 2)
                        (equal? bundle-init-log (reverse order))
                        (equal? callbacks (reverse order))
                        (= (bundle-alpha-answer) 41) (= (bundle-beta-answer) 53)
                        (= (- (bundle-image-count) before) delta)))
              (error "missing linker entry did not preserve initialized state")))
        (display "MULTI-ENTRY-BUNDLE-OK ") (write (list grouped? order delta)) (newline)))))

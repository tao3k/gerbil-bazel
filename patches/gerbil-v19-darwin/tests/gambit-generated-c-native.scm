;; Native GSC hook. Only explicit-output closed C requests are admitted.
(define (generated-c-native-register! file options directory proof work)
  (let ((index (getenv "GAMBIT_GENERATED_C_PRODUCER_INDEX" #f))
        (module (assq 'module-ref options)))
    (if (and index module (generation-regular? proof))
        (let* ((alias (symbol->string (cadr module)))
               (pending (string-append work "/producer-index")))
          (if (not (and (string=? alias (path-strip-directory alias))
                        (not (member alias '("." "..")))))
              (error "invalid native producer index alias"))
          (call-with-output-file (list path: pending permissions: #o600)
            (lambda (port)
              (write (list 'native-generated-c-producer-v1 (path-normalize file)
                           options (path-normalize directory) proof alias) port)
              (newline port)))
          (rename-file pending (path-expand (string-append alias ".producer") index))))))

(define (generated-c-native-link-options? options)
  (let loop ((remaining options) (link-count 0) (seen '()))
    (if (null? remaining)
        (= link-count 1)
        (let ((option (car remaining)))
          (and (list? option) (pair? option)
               (not (memq (car option) seen))
               (case (car option)
                 ((link) (and (= (length option) 1)
                              (loop (cdr remaining) (+ link-count 1) (cons 'link seen))))
                 ((target) (and (equal? option '(target C))
                                (loop (cdr remaining) link-count (cons 'target seen))))
                 ((o l) (and (= (length option) 2) (string? (cadr option))
                             (loop (cdr remaining) link-count (cons (car option) seen))))
                 (else #f)))))))

(define (generated-c-native-link-arguments options arguments)
  (with-exception-catcher (lambda (failure) arguments)
    (lambda ()
      (let ((index (getenv "GAMBIT_GENERATED_C_PRODUCER_INDEX" #f))
            (os (symbol->string (caddr (system-type)))))
        (if (not (and index (>= (string-length os) 6)
                      (string=? (substring os 0 6) "darwin")
                      (equal? (getenv "GAMBIT_DARWIN_NATIVE_GENERATED_C" #f) "1")
                      (generated-c-native-link-options? options)))
            arguments
            (let ((selected '()) (requests '()))
              (for-each
                (lambda (input)
                  (if (and (string? input) (string=? (path-extension input) ".scm")
                           (generation-regular? input))
                      (let* ((alias (path-strip-extension (path-strip-directory input)))
                             (record-path (path-expand (string-append alias ".producer") index)))
                        (if (generation-regular? record-path)
                            (let ((record (call-with-input-file record-path read)))
                              (if (not (and (list? record) (= (length record) 6)
                                            (eq? (car record) 'native-generated-c-producer-v1)
                                            (equal? (list-ref record 5) alias)))
                                  (error "invalid native producer index record"))
                              (set! selected (cons input selected))
                              (set! requests
                                (cons (list input (cadr record) (caddr record)
                                            (list-ref record 3) (list-ref record 4)) requests)))))))
                arguments)
              (if (null? requests) arguments
                  (let* ((executable (path-normalize (executable-path)))
                         (hash-tool (string-append (path-directory executable) "gambit-file-sha256"))
                         (tools (list executable hash-tool))
                         (scratch (create-temporary-directory (path-expand "lookup-" index))))
                    (dynamic-wind
                      (lambda () #f)
                      (lambda ()
                        (let ((pins (lookup-produced-generated-c-batch (reverse requests) scratch hash-tool tools)))
                          (if (not pins) arguments
                              (let ((mapping (map cons (reverse selected) pins)))
                                (display "GAMBIT-NATIVE-PRODUCED-C-LINK-HIT ")
                                (write (length pins)) (newline)
                                (map (lambda (input)
                                       (let ((entry (assoc input mapping)))
                                         (if entry (cdr entry) input))) arguments)))))
                      (lambda () (delete-directory scratch)))))))))))

(define (generated-c-native-options options output)
  ;; The CLI envelope selects this operation/output; it is not a compiler
  ;; transformation option. Validate it before projecting effective options.
  (let loop ((remaining options) (result '()) (c-count 0) (o-count 0))
    (if (null? remaining)
        (and (= c-count 1) (= o-count 1) (reverse result))
        (let ((option (car remaining)))
          (cond
            ((equal? option '(c)) (loop (cdr remaining) result (+ c-count 1) o-count))
            ((and (pair? option) (eq? (car option) 'o))
             (and (list? option) (= (length option) 2) (string? (cadr option))
                  output (equal? (path-normalize (cadr option)) (path-normalize output))
                  (loop (cdr remaining) result c-count (+ o-count 1))))
            (else (loop (cdr remaining) (cons option result) c-count o-count)))))))

(define (generated-c-native-compile-file-to-target file #!key options output)
  (let* ((os (symbol->string (caddr (system-type))))
         (native? (and (>= (string-length os) 6)
                       (string=? (substring os 0 6) "darwin")
                       (equal? (getenv "GAMBIT_DARWIN_NATIVE_GENERATED_C" #f) "1")))
         (effective (generated-c-native-options options output))
         (module (assq 'module-ref options))
         (linker (assq 'linker-name options)))
    (if (not (and native? output (string? output)
                  effective (generation-supported-options? effective) module linker
                  (string=? (symbol->string (cadr module)) (cadr linker))
                  (generation-regular? file)
                  (string=? (path-extension output) ".c")
                  (string=? (path-strip-extension (path-strip-directory file))
                            (path-strip-extension (path-strip-directory output)))))
        (compile-file-to-target file options: options output: output)
        (let* ((output (path-normalize output))
               (executable (path-normalize (executable-path)))
               (bin (path-directory executable))
               (hash-tool (string-append bin "gambit-file-sha256"))
               (tools (list executable hash-tool))
               (work (create-temporary-directory (string-append output ".generation-work-"))))
          (define (remove-owned path)
            (if (eq? (file-info-type (file-info path #f)) 'directory)
                (begin
                  (for-each (lambda (name) (remove-owned (path-expand name path)))
                            (directory-files path))
                  (delete-directory path))
                (delete-file path)))
          (with-exception-catcher (lambda (failure) (raise failure))
            (lambda ()
              (dynamic-wind
                (lambda () #f)
                (lambda ()
                  (reuse-generated-c-closure! (list file) effective (path-directory output)
                    work (string-append output ".generation-proof") hash-tool tools)
                  (generated-c-native-register! file effective (path-directory output)
                    (string-append output ".generation-proof") work)
                  output)
                (lambda () (remove-owned work)))))))))

(def (check name value)
  (unless value (error "hash contract failed" name))
  (displayln "CASE-OK " name)
  (force-output))

(def (table n flags)
  (##gc-hash-table-allocate n flags '#f64(.2 .5 .7)))

(def (moved! tab)
  (##gc-hash-table-field-set! tab 1
    (##fxior 4 (##gc-hash-table-field-ref tab 1))))

(def (cleared? tab)
  (##fxzero? (##fxand 4 (##gc-hash-table-field-ref tab 1))))

(def empty (table 4 16))
(def tab (table 32 16))
(def key (cons 'key 'identity))
(def value (cons 'value 'identity))
(check "missing" (eq? (##gc-hash-table-ref empty key) (##gc-hash-table-ref tab key)))
(check "insert-status" (eq? #f (##gc-hash-table-set! tab key value)))
(check "identity" (eq? value (##gc-hash-table-ref tab key)))
(check "replace-false" (and (eq? #f (##gc-hash-table-set! tab key #f))
                           (eq? #f (##gc-hash-table-ref tab key))))
(moved! tab)
(check "ref-rehash" (and (eq? #f (##gc-hash-table-ref tab key)) (cleared? tab)))
(moved! tab)
(check "set-rehash" (and (eq? #f (##gc-hash-table-set! tab key value))
                        (cleared? tab) (eq? value (##gc-hash-table-ref tab key))))
(set-car! value 'changed)
(check "live-value" (eq? 'changed (car (##gc-hash-table-ref tab key))))
(def slot
  (let loop ((i 5))
    (if (eq? key (##gc-hash-table-field-ref tab i)) i (loop (+ i 2)))))
(##gc-hash-table-field-set! tab (+ slot 1) 79)
(check "raw-slot-update" (= 79 (##gc-hash-table-ref tab key)))
(##gc)
(check "post-gc" (= 79 (##gc-hash-table-ref tab key)))
(def dense (table 32 0))
(def capacity (quotient (- (##gc-hash-table-length dense) 5) 2))
(def resize-signaled? #f)
(let loop ((i 0))
  (when (< i (- capacity 2))
    (when (##gc-hash-table-set! dense i (+ i 100)) (set! resize-signaled? #t))
    (loop (+ i 1))))
(check "resize-status" resize-signaled?)
(check "collision-contents"
  (let loop ((i 0))
    (or (= i (- capacity 2))
        (and (= (+ i 100) (##gc-hash-table-ref dense i)) (loop (+ i 1))))))
(moved! dense)
(check "dense-rehash" (and (= 100 (##gc-hash-table-ref dense 0)) (cleared? dense)))
(def weak (table 4 19))
(def weak-key (cons 5 7))
(def weak-value (cons 11 13))
(check "weak-insert" (eq? #f (##gc-hash-table-set! weak weak-key weak-value)))
(##gc)
(check "weak-live-roots" (eq? weak-value (##gc-hash-table-ref weak weak-key)))
(displayln "OK hash-cold-tail-semantics")
(force-output)

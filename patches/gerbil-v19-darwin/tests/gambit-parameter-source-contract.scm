(declare (standard-bindings) (extended-bindings) (not safe))
(define checks 0)
(define (check actual expected)
  (if (not (equal? actual expected)) (error "parameter source contract" actual expected))
  (set! checks (+ checks 1)))
(define p (make-parameter 1))
(define q (make-parameter 2))
(define r (make-parameter 3))
(define s (make-parameter 4))
(define filters 0)
(define filtered (make-parameter 3 (lambda (x) (+ x 1))
                  (lambda (x) (set! filters (+ filters 1)) (+ x 10))))
(let loop ((n 0))
  (if (< n 100)
      (begin
        (check (p) 1)
        (parameterize ((p (+ n 20)) (q (+ n 30)) (r (+ n 40)) (s (+ n 50)))
          (check (p) (+ n 20))
          (check (p) (+ n 20))
          (check (q) (+ n 30))
          (check (r) (+ n 40))
          (check (s) (+ n 50))
          (check (p) (+ n 20))
          (check (call-with-values (lambda () (p)) list) (list (+ n 20)))
          (##gc)
          (check (p) (+ n 20))
          (p 77) (check (p) 77))
        (check (p) 1)
        (check (filtered) 14)
        (check (filtered) 14)
        (check (##parameter? filtered) #t)
        (loop (+ n 1)))))
(check filters 200)
(check (call/cc (lambda (escape) (parameterize ((p 99)) (escape (p))))) 99)
(check (p) 1)
(p 5) (check (p) 5)
(check (with-exception-catcher (lambda (e) 'caught) (lambda () (p 1 2))) 'caught)
(let ((port (open-output-string)))
  (parameterize ((current-output-port port))
    (display "special")
    (check (eq? (current-output-port) port) #t))
  (check (get-output-string port) "special"))
(let* ((child (make-thread (lambda ()
                            (parameterize ((p 123))
                              (thread-yield!)
                              (##gc)
                              (p)))))
       (ignored (thread-start! child)))
  (check (thread-join! child) 123)
  (check (p) 5))
(let ((multiple (make-parameter 7 (lambda (x) x) (lambda (x) (values x (+ x 1)))))
      (throwing (make-parameter 7 (lambda (x) x) (lambda (x) (error "getter invoked")))))
  (check (call-with-values multiple list) '(7 8))
  (check (with-exception-catcher (lambda (e) 'caught) throwing) 'caught)
  (check (##parameter? multiple) #t))
(display "PARAMETER-SOURCE-OK ") (display checks) (newline)

(declare (standard-bindings) (extended-bindings) (not safe))

(define-type gb-fresh-node item tail)

(define (##gb-fresh-probe value)
  (if (pair? value) (car value) value))

(define (##gb-fresh-node-make value)
  (make-gb-fresh-node (##gb-fresh-probe value) 19))

(define (##gb-fresh-node-invoke value)
  (##gb-fresh-node-make value))

(define (##gb-fresh-node-payload node)
  (if (gb-fresh-node? node) (##unchecked-structure-ref node 1 #f #f) node))

(define (##gb-fresh-node-elide value)
  (##gb-fresh-node-payload (##gb-fresh-node-make value)))

(define (##gb-fresh-finish value)
  (if (pair? (car value))
      (cons (caar value) (cdr value))
      (cons (car value) (cdr value))))

(define (##gb-fresh-make value)
  (##gb-fresh-finish (cons value 19)))

(define (##gb-fresh-invoke value)
  (##gb-fresh-make value))

(define (##gb-fresh-observe value)
  value)

(define (##gb-fresh-observe-invoke value)
  (##gb-fresh-observe (##gb-fresh-make value)))

(define (##gb-tree-check value)
  (if (not value) (error "fresh tree contract failed")))

(define (##gb-tree-run)
  (let ((input (cons 17 23)))
    (let ((first (##gb-fresh-invoke input))
          (second (##gb-fresh-invoke input)))
      (##gb-tree-check (not (eq? first second)))
      (set-car! first 101)
      (##gb-tree-check (= (car second) 17))
      (##gb-tree-check (= (car input) 17)))
    (set-car! input 31)
    (##gc)
    (let ((first (##gb-fresh-node-invoke input))
          (second (##gb-fresh-node-invoke 43)))
      (##gb-tree-check (= (gb-fresh-node-item first) 31))
      (##gb-tree-check (= (gb-fresh-node-item second) 43))
      (gb-fresh-node-item-set! first 101)
      (##gb-tree-check (= (gb-fresh-node-item second) 43))
      (##gc)
      (##gb-tree-check (= (gb-fresh-node-item first) 101)))
    (##gb-tree-check (= (car (##gb-fresh-invoke input)) 31))
    (##gb-tree-check (= (car (##gb-fresh-invoke 43)) 43))
    (##gb-tree-check (= (##gb-fresh-node-elide input) 31))
    (##gb-tree-check (= (##gb-fresh-node-elide 43) 43))
    (let ((original ##gb-fresh-node-payload))
      (set! ##gb-fresh-node-payload (lambda (node) (##gc) node))
      (let ((node (##gb-fresh-node-elide input)))
        (##gb-tree-check (gb-fresh-node? node))
        (##gb-tree-check (= (gb-fresh-node-item node) 31)))
      (set! ##gb-fresh-node-payload original))
    (##gb-tree-check (= (car (##gb-fresh-observe-invoke input)) 31))
    (let ((original ##gb-fresh-observe))
      (set! ##gb-fresh-observe (lambda (value) (##gc) value))
      (##gb-tree-check (= (car (##gb-fresh-observe-invoke input)) 31))
      (set! ##gb-fresh-observe original))
    (let ((original ##gb-fresh-finish))
      (set! ##gb-fresh-finish (lambda (value) (##gc) value))
      (let ((answer (##gb-fresh-invoke input)))
        (##gb-tree-check (eq? (car answer) input))
        (##gb-tree-check (= (cdr answer) 19)))
      (set! ##gb-fresh-finish (lambda (value) (values (car value) (cdr value))))
      (call-with-values
        (lambda () (##gb-fresh-invoke input))
        (lambda (first second)
          (##gb-tree-check (eq? first input))
          (##gb-tree-check (= second 19))))
      (set! ##gb-fresh-finish (lambda (value) (error "expected escape")))
      (##gb-tree-check
        (with-exception-catcher
          (lambda (exception) #t)
          (lambda () (##gb-fresh-invoke input) #f)))
      (let ((answer
              (call-with-current-continuation
                (lambda (return)
                  (set! ##gb-fresh-finish (lambda (value) (return value)))
                  (##gb-fresh-invoke input)))))
        (##gb-tree-check (eq? (car answer) input)))
      (set! ##gb-fresh-finish original))
    (let loop ((index 0) (sum 0))
      (if (= index 512)
          (##gb-tree-check (= sum (* 512 31)))
          (loop (+ index 1) (+ sum (car (##gb-fresh-invoke input)))))))
  #t)

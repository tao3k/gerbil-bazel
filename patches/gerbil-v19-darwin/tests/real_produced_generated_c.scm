(define (run-real-produced-generated-c!)
  (let* ((root (getenv "GENERATION_FIXTURE")) (bin (getenv "GENERATION_BIN"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (output (string-append root "/published"))
         (tools (list (string-append bin "/gsc") hash-tool
                      (getenv "GENERATION_JOURNAL") (getenv "GENERATION_IMPLEMENTATION")
                      (getenv "GENERATION_CONTRACT")))
         (inputs (call-with-input-file (string-append root "/ordered-inputs.txt")
                   (lambda (port)
                     (let loop ((paths '()))
                       (let ((path (read-line port)))
                         (if (eof-object? path) (reverse paths) (loop (cons path paths))))))))
         (requests '()))
    (if (not (= (length inputs) 55)) (error "unexpected real producer inventory"))
    (let ((start (time->seconds (current-time))))
      (let loop ((paths inputs) (index 0))
        (if (pair? paths)
            (let* ((static (car paths))
                   (alias (path-strip-extension (path-strip-directory static)))
                   (name (string-append "producer-" (number->string index)))
                   (dynamic (string-append root "/dynamic/" name ".scm"))
                   (proof (string-append output "/" name ".c.proof"))
                   (work (string-append root "/work/" name))
                   (options (list '(target C) (list 'module-ref (string->symbol alias))
                                  (list 'linker-name alias))))
              (copy-file static dynamic)
              (create-directory work)
              (reuse-generated-c-closure! (list dynamic) options output work proof hash-tool tools)
              (if (not (generation-regular? proof)) (error "real producer not cache-admitted" static))
              (set! requests (cons (list static dynamic options proof) requests))
              (loop (cdr paths) (+ index 1)))))
      (display "REAL-PRODUCED-C population ")
      (write (- (time->seconds (current-time)) start)) (newline))
    (set! requests (reverse requests))
    (let* ((start (time->seconds (current-time)))
           (pins (lookup-produced-generated-c-batch
                   (map (lambda (request) (list (car request) (cadr request) (caddr request)
                                                output (cadddr request))) requests)
                   (string-append root "/lookup") hash-tool tools)))
      (if (not pins) (error "real producer batch rejected"))
      (display "REAL-PRODUCED-C lookup ")
      (write (- (time->seconds (current-time)) start)) (newline)
      (call-with-output-file (string-append root "/pinned-inputs.txt")
        (lambda (port) (for-each (lambda (pin) (display pin port) (newline port)) pins))))
    (if (not (null? (directory-files (string-append root "/lookup"))))
        (error "real lookup left generated outputs"))
    (display "REAL-PRODUCED-C-OK 55\n")))

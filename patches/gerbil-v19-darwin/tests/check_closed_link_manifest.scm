(let* ((path (getenv "CLOSED_BINDING"))
       (count (string->number (getenv "CLOSED_BINDING_COUNT")))
       (record (call-with-input-file path read))
       (hash-tool (string-append (path-directory (path-normalize (executable-path)))
                                "gambit-file-sha256")))
  (if (not (and (list? record) (= (length record) 2)
                (eq? (car record) 'gambit-closed-link-binding-v1)
                (list? (cadr record)) (= (length (cadr record)) count)))
      (error "closed link binding envelope drift"))
  (for-each
    (lambda (entry)
      (if (not (and (list? entry) (= (length entry) 3)
                    (string? (car entry)) (string? (cadr entry))
                    (string? (caddr entry))
                    (equal? (caddr entry) (c#generation-file-sha hash-tool (cadr entry)))))
          (error "closed link C identity drift" entry)))
    (cadr record))
  (display "CLOSED-LINK-MANIFEST-OK ") (write count) (newline))

;;; Diagnostic only: inspect the native serializer, never install a cached context.
(import :std/encoding/json
        :gerbil-parser/t/fixtures/tla-sany-differential/exit-child-process)

(def visits 0)
(def (observe-object object)
  (set! visits (+ visits 1))
  (when (zero? (modulo visits 65536))
    (displayln "SERIALIZATION-WALK objects=" visits)
    (force-output))
  (when (> visits 2000000)
    (error "diagnostic serialization object budget exceeded"))
  object)

(def (finish result)
  (displayln "SERIALIZATION-PROBE " (json->string result))
  (force-output)
  (test-child-process-exit! 0))

(def (main)
  (let (original (gx#import-module ':std/build-script #f #t))
    (displayln "SERIALIZATION-CONTEXT-READY")
    (force-output)
    (with-catch
     (lambda (exception)
       (displayln "SERIALIZATION-REFUSED")
       (display-exception exception)
       (force-output)
       (finish (hash (serializable #f) (visitedObjects visits)
                     (registryRestored #f) (diagnosticOnly #t))))
     (lambda ()
       (let* ((bytes (##object->u8vector original observe-object))
              (_ (begin (displayln "SERIALIZATION-ENCODED bytes=" (u8vector-length bytes))
                        (force-output)))
              (restored (##u8vector->object bytes)))
         (finish (hash (serializable #t) (visitedObjects visits)
                       (bytes (u8vector-length bytes))
                       (moduleContextPredicate (gx#module-context? restored))
                       (contextIdEqual (equal? (gx#expander-context-id original)
                                               (gx#expander-context-id restored)))
                       (contextPathEqual (equal? (gx#module-context-path original)
                                                 (gx#module-context-path restored)))
                       (registryRestored #f) (diagnosticOnly #t))))))))

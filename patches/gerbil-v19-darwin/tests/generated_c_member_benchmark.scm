(define (run-member-benchmark! phase)
  (let* ((root (getenv "GENERATION_FIXTURE"))
         (bin (getenv "GENERATION_BIN"))
         (hash-tool (string-append bin "/gambit-file-sha256"))
         (directory (string-append root "/published"))
         (tools (list (string-append bin "/gsc") hash-tool
                      (getenv "GENERATION_IMPLEMENTATION") (getenv "GENERATION_CONTRACT")))
         (inputs (call-with-input-file (string-append root "/inputs.txt")
                   (lambda (port)
                     (let loop ((paths '()))
                       (let ((path (read-line port)))
                         (if (eof-object? path) (reverse paths)
                             (loop (cons (string-append root "/" path) paths))))))))
         (work (string-append root "/" phase))
         (group? (member phase '("group-populate" "group-hit" "group-change"))))
    (create-directory work)
    (if (string=? phase "group-change")
        (call-with-output-file (list path: (car inputs) append: #t)
          (lambda (port) (display "\n(define __member_cache_probe 29)\n" port))))
    (let* ((start (time->seconds (current-time)))
           (pins (if group?
                     (c#reuse-generated-c-closure! inputs '((target C)) directory work
                       (string-append directory "/group.proof") hash-tool tools)
                     (reuse-generated-c-members! inputs '((target C)) directory work hash-tool tools)))
           (elapsed (- (time->seconds (current-time)) start)))
      (if (not (= (length pins) (length inputs))) (error "benchmark lost member"))
      (for-each
        (lambda (input pin)
          (let ((logical (string-append directory "/"
                           (path-strip-extension (path-strip-directory input)) ".c")))
            (if (not (equal? (c#generation-file-sha hash-tool logical)
                            (c#generation-file-sha hash-tool pin)))
                (error "benchmark pin differs from logical C"))))
        inputs pins)
      (display "MEMBER-PROOF-BENCH ") (display phase)
      (display " seconds=") (write elapsed)
      (display " modules=") (write (length inputs)) (newline))))

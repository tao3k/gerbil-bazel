(define (projection-symbol-uses node name)
  (cond
    ((and (pair? node) (eq? (car node) 'quote)) 0)
    ((pair? node)
     (+ (projection-symbol-uses (car node) name)
        (projection-symbol-uses (cdr node) name)))
    (else (if (eq? node name) 1 0))))

(define (projection-read-forms path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((forms '()))
        (let ((form (read port)))
          (if (eof-object? form) (reverse forms)
            (loop (cons form forms))))))))

(define (projection-rewrite-forms forms)
  (let ((changes '()) (targets '(gx#core-expand1 gx#core-expand-head)))
    (define (transform node owner)
      (if (not (pair? node)) node
        (if (eq? (car node) 'quote) node
          (let ((owner (if (and (eq? (car node) 'define) (pair? (cdr node)))
                         (cadr node) owner)))
            (define (unchanged)
              (cons (transform (car node) owner)
                    (transform (cdr node) owner)))
            (if (and (memq owner targets) (list? node) (= (length node) 3)
                     (eq? (car node) 'let) (list? (cadr node))
                     (= (length (cadr node)) 1)
                     (list? (caadr node)) (= (length (caadr node)) 2))
              (let* ((binding (caadr node)) (pair-name (car binding))
                     (call (cadr binding)) (inner (caddr node)))
                (if (and (list? call) (= (length call) 2) (eq? (car call) 'gx#syntax-e)
                         (list? inner) (>= (length inner) 3) (eq? (car inner) 'let)
                         (list? (cadr inner)) (= (length (cadr inner)) 2))
                  (let ((head (caadr inner)) (tail (cadadr inner)))
                    (if (and (list? head) (= (length head) 2)
                             (list? tail) (= (length tail) 2)
                             (equal? (cadr head) (list '##car pair-name))
                             (equal? (cadr tail) (list '##cdr pair-name))
                             (= (projection-symbol-uses (cddr inner) pair-name) 0)
                             (= (projection-symbol-uses (cddr inner) (car tail)) 0))
                      (begin
                        (set! changes (cons owner changes))
                        (cons 'let
                          (cons (list (list (car head) (list 'projection/car (cadr call))))
                            (map (lambda (body) (transform body owner)) (cddr inner)))))
                      (unchanged)))
                  (unchanged)))
              (unchanged))))))
    (let ((result (map (lambda (form) (transform form #f)) forms)))
      (if (and (= (length changes) 2)
               (memq 'gx#core-expand1 changes) (memq 'gx#core-expand-head changes))
        result
        (error "exact two hotspot transformations required" changes)))))

(define (projection-write-core input output)
  (let ((forms (projection-rewrite-forms (projection-read-forms input))))
    (if (file-exists? output) (error "refusing existing output" output))
    (call-with-output-file output
      (lambda (port)
        (for-each (lambda (form) (write form port) (newline port)) forms)))
    (display "GENERATE-CORE-OK")
    (newline)))

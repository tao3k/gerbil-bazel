diff --git a/bin/gambit-native-object-cache.unix b/bin/gambit-native-object-cache.unix
new file mode 100755
index 0000000..f53bdda
--- /dev/null
+++ b/bin/gambit-native-object-cache.unix
@@ -0,0 +1,111 @@
+#!/bin/sh
+
+gambit_native_object_subcommand()
+{
+  program=$1
+  shift
+  case "${program##*/}" in
+    collect2)
+      test -n "${GAMBIT_NATIVE_CAPTURE_DIRECTORY-}" || return 2
+      index=0
+      for argument do
+        case "$argument" in
+          *.o)
+            if test -f "$argument"; then
+              cp "$argument" "${GAMBIT_NATIVE_CAPTURE_DIRECTORY}/link-input-${index}.o" || return 2
+              index=$((index+1))
+            fi
+            ;;
+        esac
+      done
+      "$program" "$@"
+      return $?
+      ;;
+    *) exec "$program" "$@" ;;
+  esac
+}
+
+gambit_native_object_sha256()
+{
+  /usr/bin/shasum -a 256 "$1" | awk '{print $1}'
+}
+
+gambuild_dyn_with_native_object_cache()
+{
+  marker=$(printf '%s\n' '#if defined(__APPLE__) && defined(__MACH__) && defined(__GNUC__) && !defined(__clang__)' 'GAMBIT_NATIVE_DARWIN_GNU' '#endif' |
+           eval "$C_COMPILER -E -P -x c -" 2>/dev/null)
+  if test "$marker" != GAMBIT_NATIVE_DARWIN_GNU; then
+    eval "$BUILD_DYN_CMD"
+    return $?
+  fi
+
+  helper="$(dirname "$0")/gambit-native-object-cache"
+  case "$helper" in
+    *,*) printf '%s\n' 'Gambit native capture refuses a GCC wrapper path containing commas' >&2; return 2 ;;
+  esac
+  temporary=$(mktemp -d "${BUILD_DYN_OUTPUT_FILENAME_PARAM}.gambit-native-cache.XXXXXX") || return 2
+  GAMBIT_NATIVE_CAPTURE_DIRECTORY=$temporary
+  export GAMBIT_NATIVE_CAPTURE_DIRECTORY
+  original_compiler=$C_COMPILER
+  C_COMPILER="$C_COMPILER -wrapper $(shell_string_encode "$helper")"
+  BUILD_DYN_CAPTURE_CMD=$(substitute_dyn "$BUILD_DYN")
+  if test -n "${GAMBUILD_VERBOSE-}"; then
+    printf '%s\n' "$BUILD_DYN_CAPTURE_CMD"
+  fi
+  eval "$BUILD_DYN_CAPTURE_CMD"
+  status=$?
+  C_COMPILER=$original_compiler
+  unset GAMBIT_NATIVE_CAPTURE_DIRECTORY
+  if test "$status" != 0; then
+    rm -rf "$temporary"
+    return "$status"
+  fi
+
+  count=0
+  for object in "$temporary"/link-input-*.o; do
+    if test -f "$object"; then
+      captured=$object
+      count=$((count+1))
+    fi
+  done
+  # Existing-object links need no capture; multi-source images are not advertised.
+  if test "$count" != 1; then
+    rm -rf "$temporary"
+    return 0
+  fi
+  mv "$captured" "$temporary/object.o" || { rm -rf "$temporary"; return 2; }
+  image_sha=$(gambit_native_object_sha256 "$BUILD_DYN_OUTPUT_FILENAME_PARAM")
+  object_sha=$(gambit_native_object_sha256 "$temporary/object.o")
+  case "$image_sha$object_sha" in
+    *[!0123456789abcdef]*) rm -rf "$temporary"; return 2 ;;
+  esac
+  if test "${#image_sha}" != 64 || test "${#object_sha}" != 64; then
+    rm -rf "$temporary"
+    return 2
+  fi
+  directory="${BUILD_DYN_OUTPUT_FILENAME_PARAM}.gambit-native-objects.${image_sha}.${object_sha}"
+  reference="${BUILD_DYN_OUTPUT_FILENAME_PARAM}.gambit-native-objects"
+  if test -e "$reference" && { test ! -f "$reference" || test -L "$reference"; }; then
+    rm -rf "$temporary"
+    return 2
+  fi
+  printf 'schema=1\nimage-sha256=%s\nobject-sha256=%s\ndirectory=%s\n' \
+    "$image_sha" "$object_sha" "${directory##*/}" > "$temporary/reference"
+  if test -e "$directory"; then
+    if test -L "$directory" || test "$(gambit_native_object_sha256 "$directory/object.o")" != "$object_sha"; then
+      rm -rf "$temporary"
+      return 2
+    fi
+    mv -f "$temporary/reference" "$reference" || { rm -rf "$temporary"; return 2; }
+    rm -rf "$temporary"
+  else
+    mv "$temporary" "$directory" || { rm -rf "$temporary"; return 2; }
+    mv -f "$directory/reference" "$reference" || return 2
+  fi
+  return 0
+}
+
+if test "${GAMBIT_NATIVE_OBJECT_DRIVER_LOADING-}" != yes; then
+  gambit_native_object_subcommand "$@"
+  exit $?
+fi

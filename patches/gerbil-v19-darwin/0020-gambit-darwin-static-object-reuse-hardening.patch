-# Private prototype sourced by the obj branch of gambuild-C.
-# Only a complete preprocessor result and matching native context admit reuse.
+# Opt-in Darwin/GNU static object reuse; diagnostics retain the original path.
 gambit_static_sha()
 {
-  /usr/bin/shasum -a 256 "$1" | awk '{print $1}'
+  digest=$(/usr/bin/shasum -a 256 "$1") || return 2
+  digest=${digest%% *}
+  test "${#digest}" = 64 || return 2
+  case "$digest" in *[!0-9a-f]*) return 2 ;; esac
+  printf '%s\n' "$digest"
+}
+
+gambit_static_tools()
+{
+  /usr/bin/shasum -a 256 "$compiler" "$cc1" "$assembler" "$apple_as" \
+    "$0" "$(dirname "$0")/gsc" "$(dirname "$0")/gambit-static-object-reuse"
 }

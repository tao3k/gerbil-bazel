diff --git a/gsc/gambit-generated-c-members.scm b/gsc/gambit-generated-c-members.scm
new file mode 100644
--- /dev/null
+++ b/gsc/gambit-generated-c-members.scm
@@ -0,0 +1,67 @@
+;; Experimental member admission on the compiled native closure primitives.
+;; This is not installed in the default GSC dispatcher.
+(define (reuse-generated-c-members! inputs options directory work hash-tool tools)
+  (let ((os (symbol->string (caddr (system-type)))))
+    (if (not (and (>= (string-length os) 6)
+                  (string=? (substring os 0 6) "darwin")
+                  (equal? (getenv "GAMBIT_DARWIN_CLOSED_LINK_MEMBER_PROOF" #f) "1")))
+        (error "Darwin member proof opt-in required")))
+  (if (or (not (pair? inputs)) (not (c#generation-supported-options? options))
+          c#generated-c-observed-macro-context?)
+      (error "unsupported member generation context"))
+  (let* ((inputs (map path-normalize inputs))
+         (directory (path-normalize directory))
+         (outputs (map (lambda (input)
+                         (string-append directory "/"
+                           (path-strip-extension (path-strip-directory input)) ".c")) inputs))
+         (tools-before (c#generation-file-digests hash-tool tools))
+         (inputs-before (c#generation-file-digests hash-tool inputs))
+         (environment (c#generation-environment))
+         (option-image (call-with-output-string (lambda (port) (write options port))))
+         (records '())
+         (pins '())
+         (index 0))
+    (let duplicates? ((remaining outputs))
+      (if (pair? remaining)
+          (if (member (car remaining) (cdr remaining))
+              (error "duplicate member generation target")
+              (duplicates? (cdr remaining)))))
+    (for-each
+      (lambda (input output)
+        (let* ((proof (string-append output ".gambit-member-proof"))
+               (member-work (string-append work "/member-" (number->string index))))
+          (set! index (+ index 1))
+          (create-directory member-work)
+          (let* ((pin (car
+                       (if (equal? (getenv "GAMBIT_DARWIN_CLOSED_LINK_MEMBER_TOOLS_BATCH" #f) "1")
+                           (c#reuse-generated-c-closure! (list input) options directory member-work
+                             proof hash-tool tools tools-before)
+                           (c#reuse-generated-c-closure! (list input) options directory member-work
+                             proof hash-tool tools))))
+                 (record (and (c#generation-regular? proof)
+                              (call-with-input-file proof read))))
+            (if (not (and (not c#generated-c-observed-macro-context?)
+                          (list? record) (= (length record) 4)
+                          (eq? (car record) 'generated-c-closure-v2)
+                          (list? (list-ref record 3)) (= (length (list-ref record 3)) 1)
+                          (equal? (caar (list-ref record 3)) output)
+                          (equal? (cadar (list-ref record 3))
+                                  (c#generation-file-sha hash-tool pin))))
+                (error "member proof not admitted" input))
+            (set! records (cons record records))
+            (set! pins (cons (list pin (cadar (list-ref record 3))) pins)))))
+      inputs outputs)
+    ;; A later member must not hide mutation of an earlier member's include,
+    ;; compiler, option, environment or immutable C snapshot.
+    (if (not (and (c#generation-digests-current? hash-tool inputs-before)
+                  (equal? tools-before (c#generation-file-digests hash-tool tools))
+                  (equal? environment (c#generation-environment))
+                  (equal? option-image (call-with-output-string (lambda (port) (write options port))))
+                  (not c#generated-c-observed-macro-context?)
+                  (not (memq #f
+                         (map (lambda (record)
+                                (and (c#generation-digests-current? hash-tool (list-ref record 2))
+                                     (c#generation-digests-current? hash-tool (list-ref record 3)))) records)))
+                  (c#generation-digests-current? hash-tool pins)))
+        (error "member batch context changed"))
+    (map car (reverse pins))))

diff --git a/src/build/libgerbil-modules-test.ss b/src/build/libgerbil-modules-test.ss
new file mode 100644
index 0000000..c8fef59
--- /dev/null
+++ b/src/build/libgerbil-modules-test.ss
@@ -0,0 +1,53 @@
+;;; -*- Gerbil -*-
+;;; libgerbil runtime-closure manifest tests
+
+(import :gerbil/expander
+        :std/io/tempfile
+        :std/test)
+(include "libgerbil-modules.ss")
+(export libgerbil-modules-test)
+
+(def libgerbil-modules-test
+  (test-suite "test libgerbil runtime-closure manifest"
+    (test-case "deduplication preserves the original module order"
+      (check (libgerbil-remove-duplicates
+              '("runtime" "expander" "runtime" "stdlib" "expander"))
+             => '("runtime" "expander" "stdlib")))
+    (test-case "manifest round trip preserves the exact ordered closure"
+      (call-with-temporary-directory
+       "gerbil-libgerbil-manifest-test-"
+       (lambda (directory)
+         (let ((path (path-expand "libgerbil.modules" directory))
+               (modules '("gerbil/runtime" "gerbil/compiler" "std/test")))
+           (write-libgerbil-module-manifest path modules)
+           (check (read-libgerbil-module-manifest path) => modules)))))
+    (test-case "manifest rejects duplicate modules"
+      (call-with-temporary-directory
+       "gerbil-libgerbil-manifest-test-"
+       (lambda (directory)
+         (let (path (path-expand "libgerbil.modules" directory))
+           (call-with-output-file path
+             (lambda (out)
+               (write (list +libgerbil-module-manifest-schema+
+                            '("std/test" "std/test"))
+                      out)
+               (newline out)))
+           (check-exception (read-libgerbil-module-manifest path) true)))))
+    (test-case "manifest rejects a missing file"
+      (call-with-temporary-directory
+       "gerbil-libgerbil-manifest-test-"
+       (lambda (directory)
+         (check-exception
+          (read-libgerbil-module-manifest
+           (path-expand "missing.modules" directory))
+          true))))
+    (test-case "manifest rejects an unknown schema"
+      (call-with-temporary-directory
+       "gerbil-libgerbil-manifest-test-"
+       (lambda (directory)
+         (let (path (path-expand "libgerbil.modules" directory))
+           (call-with-output-file path
+             (lambda (out)
+               (write '(unknown-libgerbil-manifest ("std/test")) out)
+               (newline out)))
+           (check-exception (read-libgerbil-module-manifest path) true)))))))
diff --git a/src/build/libgerbil-modules.ss b/src/build/libgerbil-modules.ss
new file mode 100644
index 0000000..e77603e
--- /dev/null
+++ b/src/build/libgerbil-modules.ss
@@ -0,0 +1,257 @@
+;;; -*- Gerbil -*-
+;;; libgerbil runtime-closure manifest
+
+(def +libgerbil-module-manifest-schema+
+  'gerbil-libgerbil-module-manifest-v1)
+
+(def libgerbil-stdlib-exclude
+  '("gambit-sharp"                    ; _gambit#.scm wrapper
+    "foreign-test-support"))          ; test support module
+
+(def libgerbil-runtime
+  '("gerbil/runtime/gambit"
+    "gerbil/runtime/util"
+    "gerbil/runtime/table"
+    "gerbil/runtime/control"
+    "gerbil/runtime/system"
+    "gerbil/runtime/c3"
+    "gerbil/runtime/mop"
+    "gerbil/runtime/mop-system-classes"
+    "gerbil/runtime/error"
+    "gerbil/runtime/interface"
+    "gerbil/runtime/hash"
+    "gerbil/runtime/thread"
+    "gerbil/runtime/syntax"
+    "gerbil/runtime/eval"
+    "gerbil/runtime/repl"
+    "gerbil/runtime/loader"
+    "gerbil/runtime/init"
+    "gerbil/runtime"))
+
+(def libgerbil-expander
+  '("gerbil/expander/common"
+    "gerbil/expander/stx"
+    "gerbil/expander/core"
+    "gerbil/expander/top"
+    "gerbil/expander/module"
+    "gerbil/expander/compile"
+    "gerbil/expander/root"
+    "gerbil/expander/stxcase"
+    "gerbil/expander/init"
+    "gerbil/expander"))
+
+(def libgerbil-compiler
+  '("gerbil/compiler/base"
+    "gerbil/compiler/method"
+    "gerbil/compiler/compile"
+    "gerbil/compiler/optimize-base"
+    "gerbil/compiler/optimize-xform"
+    "gerbil/compiler/optimize-top"
+    "gerbil/compiler/optimize-spec"
+    "gerbil/compiler/optimize-ann"
+    "gerbil/compiler/optimize-call"
+    "gerbil/compiler/optimize"
+    "gerbil/compiler/driver"
+    "gerbil/compiler/ssxi"
+    "gerbil/compiler"))
+
+(def (libgerbil-filter-build-spec spec)
+  (def (if-not-excluded modf)
+    (if (not (member modf libgerbil-stdlib-exclude))
+      (cons (string-append "std/" modf) spec)
+      #f))
+  (match spec
+    ((? string? modf)
+     (if-not-excluded modf))
+    ([gxc: modf . _]
+     (if-not-excluded modf))
+    ([gsc: modf . _]
+     (if-not-excluded modf))
+    ([ssi: . _]
+     #f)
+    ([static-include: modf]
+     #f)))
+
+(def (libgerbil-remove-duplicates lst)
+  (let ((seen (make-hash-table)))
+    (let lp ((rest lst) (result []))
+    (match rest
+      ([hd . rest]
+       (if (hash-get seen hd)
+         (lp rest result)
+         (begin
+           (hash-put! seen hd #t)
+           (lp rest (cons hd result)))))
+      (else (reverse result))))))
+
+(def (libgerbil-order-modules all-modules (contexts #f))
+  (def started (##current-time-point))
+  (def context-hits 0)
+  (def fallback-imports 0)
+  (def visited-modules
+    (make-hash-table-eq))
+
+  (def (module-id modf)
+    (string->symbol (string-append ":" modf)))
+
+  (def (module-file modctx)
+    (symbol->string (expander-context-id modctx)))
+
+  (def (module-exclude? modctx)
+    (or (not (expander-context-id modctx))
+        (string-prefix? "gerbil/core" (symbol->string (expander-context-id modctx)))))
+
+  (def (import-set-template in phi)
+    (let ((iphi (fx+ phi (import-set-phi in)))
+          (imports (module-context-import (import-set-source in))))
+      (let lp ((rest imports) (r []))
+        (match rest
+          ([in . rest]
+           (cond
+            ((module-context? in)
+             (if (fxzero? iphi)
+               (lp rest (cons in r))
+               (lp rest r)))
+            ((module-import? in)
+             (let (iphi (fx+ phi (module-import-phi in)))
+               (if (fxzero? iphi)
+                 (lp rest (cons (module-export-context (module-import-source in)) r))
+                 (lp rest r))))
+            ((import-set? in)
+             (let (xphi (fx+ iphi (import-set-phi in)))
+               (if (fxzero? xphi)
+                 (lp rest (cons (import-set-source in) r))
+                 (lp rest r))))
+            (else
+             (lp rest r))))
+          (else r)))))
+
+  (def (find-deps modctx)
+    ;; visited-modules is committed after each root so that the historical
+    ;; ordering is preserved. Within a root, seen prevents the same shared
+    ;; dependency subgraph from being traversed repeatedly.
+    (def seen (make-hash-table-eq))
+    (let lp ((rest [modctx]) (deps []))
+      (match rest
+        ([hd . rest]
+         (cond
+          ((module-context? hd)
+           (let ((id (expander-context-id hd))
+                 (imports (module-context-import hd)))
+             (cond
+              ((or (hash-get visited-modules id)
+                   (hash-get seen id)
+                   (module-exclude? hd))
+               (lp rest deps))
+              ((core-context-prelude hd)
+               => (lambda (pre)
+                    (hash-put! seen id #t)
+                    (let (deps (lp (cons pre imports) deps))
+                      (lp rest (cons hd deps)))))
+              (else
+               (hash-put! seen id #t)
+               (let (deps (lp imports deps))
+                 (lp rest (cons hd deps)))))))
+          ((prelude-context? hd)
+           (let (id (expander-context-id hd))
+             (if (or (hash-get visited-modules id)
+                     (hash-get seen id)
+                     (module-exclude? hd))
+               (lp rest deps)
+               (begin
+                 (hash-put! seen id #t)
+                 (let (deps (lp (prelude-context-import hd) deps))
+                   (lp rest (cons hd deps)))))))
+          ((module-import? hd)
+           (if (fxzero? (module-import-phi hd))
+             (lp (cons (module-import-source hd) rest) deps)
+             (lp rest deps)))
+          ((module-export? hd)
+           (lp (cons (module-export-context hd) rest) deps))
+          ((import-set? hd)
+           (cond
+            ((fxzero? (import-set-phi hd))
+             (lp (cons (import-set-source hd) rest) deps))
+            ((fxpositive? (import-set-phi hd))
+             (let (xdeps (import-set-template hd 0))
+               (lp (foldl cons rest xdeps) deps)))
+            (else
+             (lp rest deps))))
+          (else
+           (error "unexpected dependency" hd))))
+        (else deps))))
+
+  (def (resolve-module modf mod-id)
+    (cond
+     ((and contexts (hash-get contexts (string->symbol modf)))
+      => (lambda (modctx)
+           (set! context-hits (fx1+ context-hits))
+           modctx))
+     (else
+      (set! fallback-imports (fx1+ fallback-imports))
+      (import-module mod-id))))
+
+  (let (ordered
+        (let lp ((rest all-modules) (ordered []))
+          (match rest
+            ([modf . rest]
+             (let (mod-id (module-id modf))
+               (if (hash-get visited-modules mod-id)
+                 (lp rest ordered)
+                 (let* ((modctx (resolve-module modf mod-id))
+                        (deps (find-deps modctx))
+                        (ordered
+                         (foldl
+                          (lambda (dep r)
+                            (if (hash-get visited-modules (expander-context-id dep))
+                              r
+                              (begin
+                                (hash-put! visited-modules (expander-context-id dep) #t)
+                                (cons (module-file dep) r))))
+                          ordered
+                          (reverse deps))))
+                   (lp rest ordered)))))
+            (else
+             (reverse ordered)))))
+    (displayln "... build-observe phase=manifest-closure event=end modules="
+               (length ordered)
+               " contextHits=" context-hits
+               " fallbackImports=" fallback-imports
+               " elapsedMs="
+               (inexact->exact
+                (round (* 1000 (- (##current-time-point) started)))))
+    (force-output)
+    ordered))
+
+(def (libgerbil-modules-from-build-spec build-spec (contexts #f))
+  (let* ((stdlib-spec (filter-map libgerbil-filter-build-spec build-spec))
+         (stdlib-modules (map car stdlib-spec))
+         (ordered-modules (libgerbil-order-modules stdlib-modules contexts)))
+    (libgerbil-remove-duplicates
+     (append libgerbil-runtime
+             libgerbil-expander
+             libgerbil-compiler
+             ordered-modules))))
+
+(def (write-libgerbil-module-manifest path modules)
+  (call-with-output-file path
+    (lambda (out)
+      (write (list +libgerbil-module-manifest-schema+ modules) out)
+      (newline out))))
+
+(def (read-libgerbil-module-manifest path)
+  (unless (file-exists? path)
+    (error "missing libgerbil module manifest; build stdlib first" path))
+  (let (manifest (call-with-input-file path read))
+    (unless (and (pair? manifest)
+                 (eq? (car manifest) +libgerbil-module-manifest-schema+)
+                 (pair? (cdr manifest))
+                 (null? (cddr manifest)))
+      (error "invalid libgerbil module manifest" path manifest))
+    (let (modules (cadr manifest))
+      (unless (and (list? modules)
+                   (not (ormap (lambda (module) (not (string? module))) modules))
+                   (= (length modules)
+                      (length (libgerbil-remove-duplicates modules))))
+        (error "invalid libgerbil module list" path modules))
+      modules)))

 ;;; Inner build file for std, as specially imported and called by ./build.ss for bootstrap reasons
 
-(import "build-config" "make")
+(import :gerbil/expander
+        "build-config" "make")
 (include "build-spec.ss")
+(include "../build/libgerbil-modules.ss")
 
-(def (build . args) (apply make (apply build-spec args) args))
+(def libgerbil-build-libdir
+  (path-expand "lib" (getenv "GERBIL_BUILD_PREFIX" (gerbil-home))))
+
+(def (build . args)
+  (let* ((spec (apply build-spec args))
+         (contexts (apply make/contexts spec args)))
+    (let* ((manifest (path-expand "libgerbil.modules" libgerbil-build-libdir))
+           (modules (libgerbil-modules-from-build-spec spec contexts)))
+      (write-libgerbil-module-manifest manifest modules)
+      (displayln "... build-observe phase=manifest event=end modules="
+                 (length modules)
+                 " path=" manifest)
+      (force-output))))

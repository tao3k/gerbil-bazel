diff --git a/src/gerbil/compiler/base.ss b/src/gerbil/compiler/base.ss
--- a/src/gerbil/compiler/base.ss
+++ b/src/gerbil/compiler/base.ss
@@ -360,4 +360,37 @@ namespace: gxc
 (def (make-compile-job thunk name)
-  [thunk name (##current-time-point)])
-
+  ;; The old executor created the job thread here, so Gambit captured the
+  ;; compiler parameterization at submission time.  A shared worker pool must
+  ;; preserve that semantic explicitly: by execution time the coordinator may
+  ;; already be compiling another module with different GSC/FFI options.
+  (let ((output-dir (current-compile-output-dir))
+        (invoke-gsc (current-compile-invoke-gsc))
+        (gsc-options (current-compile-gsc-options))
+        (keep-scm (current-compile-keep-scm))
+        (verbose (current-compile-verbose))
+        (optimize (current-compile-optimize))
+        (debug (current-compile-debug))
+        (generate-ssxi (current-compile-generate-ssxi))
+        (static (current-compile-static))
+        (timestamp (current-compile-timestamp))
+        (decls (current-compile-decls))
+        (context (current-compile-context))
+        (parallel (current-compile-parallel)))
+    [(lambda ()
+       (parameterize ((current-compile-output-dir output-dir)
+                      (current-compile-invoke-gsc invoke-gsc)
+                      (current-compile-gsc-options gsc-options)
+                      (current-compile-keep-scm keep-scm)
+                      (current-compile-verbose verbose)
+                      (current-compile-optimize optimize)
+                      (current-compile-debug debug)
+                      (current-compile-generate-ssxi generate-ssxi)
+                      (current-compile-static static)
+                      (current-compile-timestamp timestamp)
+                      (current-compile-decls decls)
+                      (current-compile-context context)
+                      (current-compile-parallel parallel))
+         (thunk)))
+     name
+     (##current-time-point)]))
+
 (def (execute-compile-jobs! pending verbosity)
diff --git a/src/gerbil/test/compiler-executor-test.ss b/src/gerbil/test/compiler-executor-test.ss
--- a/src/gerbil/test/compiler-executor-test.ss
+++ b/src/gerbil/test/compiler-executor-test.ss
@@ -58,5 +58,29 @@
              => #t))
-
+
+    (test-case "submission parameterization is preserved"
+      (def observed #f)
+      (parameterize ((current-compile-gsc-options
+                      '("-cc-options" "-I/submission/include"
+                        "-ld-options" "-L/submission/lib -lexample"))
+                     (current-compile-debug #t)
+                     (current-compile-context '(submission-context)))
+        (add-compile-job!
+         (lambda ()
+           (set! observed
+             (list (current-compile-gsc-options)
+                   (current-compile-debug)
+                   (current-compile-context))))
+         'parameterization))
+      (parameterize ((current-compile-gsc-options [])
+                     (current-compile-debug #f)
+                     (current-compile-context '(execution-context)))
+        (execute-pending-compile-jobs!))
+      (check observed
+             => '(("-cc-options" "-I/submission/include"
+                   "-ld-options" "-L/submission/lib -lexample")
+                  #t
+                  (submission-context))))
+
     (test-case "first error propagates after queued work drains"
       (def mx (make-mutex 'compiler-executor-error-test))
       (def survived-error 0)

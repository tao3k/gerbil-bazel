 ;; parallel build support
-(def __compile-jobs [])
-(def __available-cores
-  (string->number
-   (getenv "GERBIL_BUILD_CORES" "1")))
-(def __jobs-mx (make-mutex))
+(def (available-build-cores)
+  (let* ((value (getenv "GERBIL_BUILD_CORES" #f))
+         (configured (and value (string->number value))))
+    (if (and (integer? configured) (>= configured 0))
+      configured
+      (##core-count))))
+(def __available-cores (available-build-cores))
+(def current-compile-executor-session (make-parameter #f))
+
+(defstruct compile-executor-session (submit with-slot close)
+  transparent: #t)
 
 (defstruct compile-job-report
   (jobs workers completed errors peak-active
@@ -309,95 +315,30 @@ namespace: gxc
   (inexact->exact (round (* 1000 (- (##current-time-point) started)))))
 
 (def (add-compile-job! thunk (name (current-compile-context)))
-  (mutex-lock! __jobs-mx)
-  (let (job (make-compile-job thunk name))
-    (set! __compile-jobs (cons job __compile-jobs)))
-  (mutex-unlock! __jobs-mx))
-
-(def (pending-compile-jobs)
-  (mutex-lock! __jobs-mx)
-  (let (result (reverse! __compile-jobs))
-    (set! __compile-jobs [])
-    (mutex-unlock! __jobs-mx)
-    result))
-
-(def (execute-pending-compile-jobs! (verbosity (current-compile-verbose)))
+  (def job (make-compile-job thunk name))
+  (let (session (current-compile-executor-session))
+    (if session
+      ((compile-executor-session-submit session) job)
+      (error "parallel compilation requires an active executor session" name))))
+
+(def (call-with-compile-job-slot thunk)

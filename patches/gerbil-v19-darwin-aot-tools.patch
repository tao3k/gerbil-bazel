diff --git a/src/tools/build-aot.ss b/src/tools/build-aot.ss
new file mode 100755
index 0000000..dcd2a96
--- /dev/null
+++ b/src/tools/build-aot.ss
@@ -0,0 +1,45 @@
+#!/usr/bin/env gxi
+;; -*- Gerbil -*-
+;; Native tool targets are a separate phase because their foreign
+;; library closure must be declared on the executable build specification.
+(import :std/build-config
+        :std/make)
+
+(def aot-tools
+  '("gxpkg" "gxtags" "gxtest"))
+
+(def aot-cc-options
+  (append-options
+    (cppflags "libssl" "")
+    (cppflags "libcrypto" "")
+    (if config-enable-zlib (cppflags "zlib" "") "")
+    "-Wno-discarded-qualifiers"
+    "-Wno-deprecated-declarations"
+    "-Wno-implicit-function-declaration"))
+
+(def aot-ld-options
+  (append-options
+    (ldflags "libssl" "-lssl")
+    (ldflags "libcrypto" "-lcrypto")
+    (if config-enable-zlib (ldflags "zlib" "-lz") "")))
+
+(def (aot-tool tool)
+  (list (if (string=? tool "gxtest") exe: optimized-exe:) tool
+        "-cc-options" aot-cc-options
+        "-ld-options" aot-ld-options))
+
+(def (main . _)
+  (let* ((srcdir (current-directory))
+         (build-prefix (getenv "GERBIL_BUILD_PREFIX" (gerbil-home)))
+         (libdir (path-expand "lib" build-prefix))
+         (bindir (path-expand "bin" build-prefix)))
+    (for-each
+      (lambda (tool)
+        (displayln ">>> Building General AOT tool " tool)
+        (make (list (aot-tool tool))
+          srcdir: srcdir
+          libdir: libdir
+          bindir: bindir
+          force: #t
+          debug: #f))
+      aot-tools)))

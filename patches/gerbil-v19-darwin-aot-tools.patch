diff --git a/src/tools/build-aot.ss b/src/tools/build-aot.ss
new file mode 100755
index 0000000..2103481
--- /dev/null
+++ b/src/tools/build-aot.ss
@@ -0,0 +1,21 @@
+#!/usr/bin/env gxi
+;; -*- Gerbil -*-
+;; Build latency-sensitive tools as whole-program executables.  Each tool is
+;; closed separately so GCC never holds multiple giant C units concurrently.
+(import :std/make)
+
+(def aot-tools
+  '("gxpkg" "gxtags"))
+
+(def (main . _)
+  (let* ((srcdir (current-directory))
+         (build-prefix (getenv "GERBIL_BUILD_PREFIX" (gerbil-home)))
+         (libdir (path-expand "lib" build-prefix))
+         (bindir (path-expand "bin" build-prefix)))
+    (for-each
+      (lambda (tool)
+        (displayln ">>> Building whole-program tool " tool)
+        (make (list (list optimized-exe: tool))
+          srcdir: srcdir libdir: libdir bindir: bindir
+          force: #t parallelize: 1 debug: #f))
+      aot-tools)))

diff --git a/src/build.sh b/src/build.sh
index 20e4801..4bfd910 100755
--- a/src/build.sh
+++ b/src/build.sh
@@ -295,9 +295,27 @@ build_srfi() {
 
 build_tools () {
   feedback_low "Building gerbil tools"
   (cd tools && gxi ./build.ss) || die
+  if [ "${GERBIL_BUILD_AOT_TOOLS:-no}" = yes ]; then
+    # Close selected latency-sensitive tools one at a time: each final GCC
+    # translation unit is heavyweight, while std/make still owns worker count.
+    for aot_tool in gxpkg gxtags; do
+      (cd tools && GERBIL_AOT_TOOL="$aot_tool" gxi ./build-aot.ss) || die
+    done
+  fi
   for tool in tools/gx*.ss; do
       toolname=$(basename $tool .ss)
-      (cd "${GERBIL_BUILD_PREFIX}/bin" && ln -sf gerbil $toolname)
+      case "$toolname" in
+        gxpkg|gxtags)
+          if [ "${GERBIL_BUILD_AOT_TOOLS:-no}" = yes ]; then
+            test -x "${GERBIL_BUILD_PREFIX}/bin/${toolname}" || die
+          else
+            (cd "${GERBIL_BUILD_PREFIX}/bin" && ln -sf gerbil "$toolname")
+          fi
+          ;;
+        *)
+          (cd "${GERBIL_BUILD_PREFIX}/bin" && ln -sf gerbil "$toolname")
+          ;;
+      esac
   done
 }
diff --git a/src/tools/build-aot.ss b/src/tools/build-aot.ss
new file mode 100755
index 0000000..8a4b721
--- /dev/null
+++ b/src/tools/build-aot.ss
@@ -0,0 +1,39 @@
+#!/usr/bin/env gxi
+;; -*- Gerbil -*-
+;; Whole-program tool targets are a separate phase because their foreign
+;; library closure must be declared on the executable build specification.
+(import :std/build-script
+        :std/build-config
+        :std/make)
+
+(def aot-tool-name
+  (let (name (getenv "GERBIL_AOT_TOOL" #f))
+    (unless (or (equal? name "gxpkg") (equal? name "gxtags"))
+      (error "GERBIL_AOT_TOOL must be gxpkg or gxtags" name))
+    name))
+
+(def aot-cc-options
+  (append-options
+    (cppflags "libssl" "")
+    (cppflags "libcrypto" "")
+    (if config-enable-zlib (cppflags "zlib" "") "")
+    "-Wno-discarded-qualifiers"
+    "-Wno-deprecated-declarations"
+    "-Wno-implicit-function-declaration"))
+
+(def aot-ld-options
+  (append-options
+    (ldflags "libssl" "-lssl")
+    (ldflags "libcrypto" "-lcrypto")
+    (if config-enable-zlib (ldflags "zlib" "-lz") "")))
+
+(def (aot-tool tool)
+  (list optimized-exe: tool
+        "-cc-options" aot-cc-options
+        "-ld-options" aot-ld-options))
+
+(defbuild-script
+  (list (aot-tool aot-tool-name))
+  libdir: (path-expand "lib" (getenv "GERBIL_BUILD_PREFIX" (gerbil-home)))
+  bindir: (path-expand "bin" (getenv "GERBIL_BUILD_PREFIX" (gerbil-home)))
+  debug: #f)

+(def (run-isolated-tests files filter features verbosity global-env? jobs
+                         wall-timeout progress-timeout report-file progress-prefix
+                         selected-modules)
+  (def output-mx (and (> jobs 1) (make-mutex 'gxtest-output)))
+  (def statuses (make-hash-table))
+  (def durations (make-hash-table))
+  (def (record-duration! file started)
+    (let (elapsed (- (##current-time-point) started))
+      (if output-mx
+        (do-with-lock output-mx
+          (hash-put! durations file elapsed))
+        (hash-put! durations file elapsed))))
+  (def (passed? attempt)
+    (and (pair? attempt) (eq? (car attempt) 'pass)
+         (integer? (cdr attempt)) (zero? (cdr attempt))))
+  (def (outcome-label attempt)
+    (if (and (pair? attempt) (symbol? (car attempt)))
+      (symbol->string (car attempt))
+      "missing-result"))
+  (def (status-label attempt)
+    (let (status (and (pair? attempt) (cdr attempt)))
+      (cond
+       ((and (fixnum? status) (fxzero? (fxand status #x7f)))
+        (string-append "exit=" (number->string (fxarithmetic-shift-right status 8))))
+       ((fixnum? status)
+        (string-append "signal=" (number->string (fxand status #x7f))))
+       (else (string-append "process-status=" (object->string status))))))
+  (def (report . parts)
+    (if output-mx
+      (do-with-lock output-mx
+        (apply displayln parts)
+        (force-output))
+      (begin
+        (apply displayln parts)
+        (force-output))))
+  (def (finish)
+    (let (failed 0)
+      (for (file files)
+        (let (attempt (hash-get statuses file))
+          (unless (passed? attempt)
+            (set! failed (+ failed 1)))
+          (report (if (passed? attempt)
+                    "SUMMARY-OK " "SUMMARY-ERROR ")
+                  file " " (outcome-label attempt)
+                  " " (status-label attempt)
+                  " elapsed=" (or (hash-get durations file) 0) "s")))
+      (report "MODULE-SUMMARY selected=" (length files)
+              " modules=" selected-modules
+              " passed=" (- (length files) failed) " failed=" failed)
+      (when report-file
+        (call-with-output-file report-file
+          (lambda (port)
+            (for (file files)
+              (let (attempt (hash-get statuses file))
+                (display
+                 (json->string
+                  (hash (schema 1)
+                        (type "module-result")
+                        (path file)
+                        (outcome (outcome-label attempt))
+                        (status (status-label attempt))
+                        (elapsed_seconds (or (hash-get durations file) 0))))
+                 port)
+                (newline port)))
+            (display
+             (json->string
+              (hash (schema 1)
+                    (type "summary")
+                    (selected (length files))
+                    (selected_modules selected-modules)
+                    (passed (- (length files) failed))
+                    (failed failed)
+                    (jobs jobs)
+                    (verbosity verbosity)
+                    (filter (if filter filter (void)))
+                    (features (map symbol->string features))
+                    (global_env global-env?)
+                    (timeout_seconds wall-timeout)
